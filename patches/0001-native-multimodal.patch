+func TestSpeechChunksAndBackendErrorsRemainUnmodified(t *testing.T) {
+	r := &OpenAIRouter{}
+	for _, code := range []string{"200", "400", "503"} {
+		ctx := &RequestContext{SourceFormat: llmprotocol.OpenAISpeechV1, TargetFormat: llmprotocol.OpenAISpeechV1}
+		// Body path must not parse even a backend JSON error or partial audio.
+		for _, chunk := range [][]byte{{0, 255, 1}, []byte(`{"error":{"message":"voice unavailable"}}`)} {
+			resp, err := r.handleResponseBody(&ext_proc.ProcessingRequest_ResponseBody{ResponseBody: &ext_proc.HttpBody{Body: chunk}}, ctx)
+			if err != nil || resp.GetResponseBody().GetResponse().BodyMutation != nil {
+				t.Fatalf("chunk was changed: %v", err)
+			}
+		}
+		ctx.UpstreamStatusCode = getStatusFromHeaders(&core.HeaderMap{Headers: []*core.HeaderValue{{Key: ":status", Value: code}}})
+		if ctx.UpstreamStatusCode == 0 {
+			t.Fatal("status lost")
+		}
+	}
+}
