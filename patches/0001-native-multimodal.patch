new file mode 100644
index 000000000..255aed159
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/speech_generation.go
@@ -0,0 +1,93 @@
+package llmprotocol
+
+import (
+	"encoding/json"
+	"math"
+	"strings"
+)
+
+// SpeechGenerationOptions is a task, not a Chat audio-output request. The
+// fields mirror the pinned Omni Speech API. Engine-specific support is still
+// checked by the selected backend and its original error is preserved.
+type SpeechGenerationOptions struct {
+	Input                   string                     `json:"input"`
+	Voice                   json.RawMessage            `json:"voice,omitempty"`
+	Instructions            *string                    `json:"instructions,omitempty"`
+	ResponseFormat          string                     `json:"response_format,omitempty"`
+	Speed                   *float64                   `json:"speed,omitempty"`
+	SampleRate              *int64                     `json:"sample_rate,omitempty"`
+	StreamFormat            string                     `json:"stream_format,omitempty"`
+	TaskType                string                     `json:"task_type,omitempty"`
+	Language                *string                    `json:"language,omitempty"`
+	RefAudio                json.RawMessage            `json:"ref_audio,omitempty"`
+	RefText                 *string                    `json:"ref_text,omitempty"`
+	RefAudio2               *string                    `json:"ref_audio_2,omitempty"`
+	AmbientSound            *string                    `json:"ambient_sound,omitempty"`
+	DurationSeconds         *float64                   `json:"duration_seconds,omitempty"`
+	XVectorOnlyMode         *bool                      `json:"x_vector_only_mode,omitempty"`
+	SpeakerEmbedding        json.RawMessage            `json:"speaker_embedding,omitempty"`
+	MaxNewTokens            *int64                     `json:"max_new_tokens,omitempty"`
+	Seed                    *int64                     `json:"seed,omitempty"`
+	InitialCodecChunkFrames *int64                     `json:"initial_codec_chunk_frames,omitempty"`
+	NonStreamingMode        *bool                      `json:"non_streaming_mode,omitempty"`
+	ExtraParams             map[string]json.RawMessage `json:"extra_params,omitempty"`
+	WordTimestamps          bool                       `json:"word_timestamps,omitempty"`
+}
+
+func ValidateSpeechGeneration(request Request) error {
+	s := request.SpeechGeneration
+	if s == nil {
+		return nil
+	}
+	invalid := func(message string) error {
+		return NewError(ErrorInvalidRequest, "invalid_speech_request", message, nil)
+	}
+	if strings.TrimSpace(s.Input) == "" {
+		return invalid("speech input is required")
+	}
+	if request.ImageGeneration != nil || len(request.Tools) != 0 || len(request.Instructions) != 0 {
+		return invalid("speech cannot contain image generation, tools or system instructions")
+	}
+	if len(request.Messages) != 1 || request.Messages[0].Role != RoleUser ||
+		len(request.Messages[0].Content) != 1 || request.Messages[0].Content[0].Kind != ContentText ||
+		request.Messages[0].Content[0].Text != s.Input {
+		return invalid("speech signal text must equal the synthesis input")
+	}
+	switch s.ResponseFormat {
+	case "", "wav", "pcm", "mp3", "flac", "opus":
+	default:
+		return invalid("unsupported speech response_format")
+	}
+	switch s.StreamFormat {
+	case "", "sse", "audio":
+	default:
+		return invalid("unsupported speech stream_format")
+	}
+	if s.Speed != nil && (math.IsNaN(*s.Speed) || math.IsInf(*s.Speed, 0) || *s.Speed < .25 || *s.Speed > 4) {
+		return invalid("speech speed must be between 0.25 and 4")
+	}
+	if s.SampleRate != nil && *s.SampleRate <= 0 {
+		return invalid("sample_rate must be positive")
+	}
+	if s.MaxNewTokens != nil && *s.MaxNewTokens <= 0 {
+		return invalid("max_new_tokens must be positive")
+	}
+	if s.InitialCodecChunkFrames != nil && *s.InitialCodecChunkFrames < 0 {
+		return invalid("initial_codec_chunk_frames cannot be negative")
+	}
+	if s.DurationSeconds != nil && *s.DurationSeconds < 0 {
+		return invalid("duration_seconds cannot be negative")
+	}
+	if request.Stream && s.ResponseFormat != "" && s.ResponseFormat != "wav" && s.ResponseFormat != "pcm" {
+		return invalid("streaming speech requires wav or pcm")
+	}
+	if request.Stream && s.WordTimestamps {
+		return invalid("word_timestamps requires non-streaming speech")
+	}
+	switch s.TaskType {
+	case "", "CustomVoice", "VoiceDesign", "Base":
+	default:
+		return invalid("unsupported speech task_type")
+	}
+	return nil
+}
