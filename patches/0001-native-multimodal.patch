+	if wire["seed"] != float64(7) || wire["response_format"] != "url" || wire["prompt"] != "a blue square" {
+		t.Fatalf("image controls lost: %v", wire)
+	}
+	chat := testNeutralRequest("auto", "chat")
+	if _, err := r.prepareProviderDispatch(chat, model, "", false, routingTestContext(llmprotocol.OpenAIChatV1, chat)); err == nil {
+		t.Fatal("image sink accepted a chat task")
