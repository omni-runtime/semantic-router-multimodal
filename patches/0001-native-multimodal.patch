+package config
+
+import (
+	"fmt"
+	"testing"
+)
+
+func TestMultimodalCanonicalCatalog(t *testing.T) {
+	for _, format := range []string{APIFormatMLXVideo, APIFormatRealtime, APIFormatSpeechStream, APIFormatSpeech, APIFormatImages, APIFormatTranscription, APIFormatTranslation, APIFormatImageEdit, APIFormatVideo, APIFormatVideoSync, APIFormatAudioGenerate} {
+		t.Run(format, func(t *testing.T) {
+			provider := "vllm-omni"
+			if format == APIFormatMLXVideo {
+				provider = "mlx-serve"
+			}
+			cfg, err := ParseYAMLBytes([]byte(fmt.Sprintf(`
+version: v0.3
+providers:
+  models:
+    - name: media
+      api_format: %s
+      provider_model_id: native-media
+      backend_refs:
+        - name: primary
+          provider: %s
+          base_url: http://media:8000/v1
+routing: {}
+global:
+  router:
+    require_entrypoint: true
+`, format, provider)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cfg.GetModelAPIFormat("media") != format || !cfg.RequireEntrypoint {
+				t.Fatalf("lost media format or entrypoint requirement: %+v", cfg.ModelConfig["media"])
+			}
+			if len(cfg.GetEndpointsForModel("media")) != 1 {
+				t.Fatal("media provider endpoint missing")
+			}
+			canonical := CanonicalConfigFromRouterConfig(cfg)
+			if canonical.Providers.Models[0].APIFormat != format {
+				t.Fatal("canonical export lost media dialect")
+			}
+		})
+	}
+}
