+	if !errors.Is(err, selection.ErrNoEligibleCandidates) {
+		t.Fatalf("input-only model qualified: %v", err)
+	}
+	params.Capabilities = []string{"text", "audio_output"}
+	r.Config.ModelConfig[model] = params
+	if _, err := r.prepareProviderDispatch(request, model, "", false, ctx); err != nil {
+		t.Fatal(err)
+	}
+	if !isNativeMediaPassthrough(ctx) {
+		t.Fatal("mixed response would lose native audio metadata")
+	}
+	for _, chunk := range [][]byte{[]byte(`{"choices":[{"message":{"content":"hi","audio":{"data":"YQ==","id":"a"}}}]}`), []byte("data: {\"choices\":[{\"delta\":{\"audio\":{\"data\":\"YQ==\"}}}]}\n\n"), []byte(`{"error":{"code":"native-error"}}`)} {
+		response, err := r.handleResponseBody(&ext_proc.ProcessingRequest_ResponseBody{ResponseBody: &ext_proc.HttpBody{Body: chunk}}, ctx)
+		if err != nil || response.GetResponseBody().GetResponse().BodyMutation != nil {
+			t.Fatal("native output rewritten", err)
+		}
+	}
+	ctx.TargetFormat = llmprotocol.OpenAIResponsesV1
+	if isNativeMediaPassthrough(ctx) {
+		t.Fatal("cross-wire passthrough enabled")
