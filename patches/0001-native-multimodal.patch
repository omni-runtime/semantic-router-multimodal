+package protocolcodec
+
+import (
+	"encoding/json"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"reflect"
+	"testing"
+)
+
+func TestNativeAudioGenerationRetainsDiffusionTask(t *testing.T) {
+	engine := NewBuiltinEngine()
+	body := []byte(`{"model":"auto","input":"rainfall","response_format":"wav","speed":1.5,"stream_format":"audio","audio_length":2.5,"audio_start":0.5,"negative_prompt":"voice","guidance_scale":7,"num_inference_steps":4,"seed":7}`)
+	result, err := engine.TranslateRequest(llmprotocol.OmniAudioGenerateV1, llmprotocol.OmniAudioGenerateV1, body, func(r *llmprotocol.Request) error { r.Model = "diffusion"; r.Generation++; return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got, want map[string]any
+	json.Unmarshal(result.Body, &got)
+	json.Unmarshal(body, &want)
+	want["model"] = "diffusion"
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("audio fields lost: %v", got)
+	}
+	required := llmprotocol.RequiredCapabilities(result.Request)
+	if !required.Supports(llmprotocol.CapabilityAudioGeneration) || required.Supports(llmprotocol.CapabilitySpeechGeneration) {
+		t.Fatal("audio generation confused with speech")
+	}
+	if _, err := engine.EncodeRequest(llmprotocol.OpenAISpeechV1, result.Request, result.Envelope); err == nil {
+		t.Fatal("diffusion audio was translated to TTS")
+	}
+	for _, body := range []string{`{"model":"auto","input":"rain","stream_format":"sse"}`, `{"model":"auto","input":"rain","audio_length":0}`, `{"model":"auto","input":"rain","voice":"v"}`, `{"model":"auto","input":"rain","num_inference_steps":1001}`} {
+		if _, _, _, err := engine.DecodeRequest(llmprotocol.OmniAudioGenerateV1, []byte(body)); err == nil {
+			t.Fatalf("invalid audio generation accepted: %s", body)
+		}
+	}
+}
+
+func TestChatNativeVideoRoundTripAndCapability(t *testing.T) {
+	engine := NewBuiltinEngine()
+	for _, url := range []string{"https://example.com/video.mp4", "data:video/mp4;base64,AAAAAGZ0eXBtcDQy"} {
+		body := []byte(`{"model":"auto","messages":[{"role":"user","content":[{"type":"text","text":"Describe"},{"type":"video_url","video_url":{"url":"` + url + `"}}]}]}`)
+		result, err := engine.TranslateRequest(llmprotocol.OpenAIChatV1, llmprotocol.OpenAIChatV1, body, func(r *llmprotocol.Request) error { r.Model = "video-model"; r.Generation++; return nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !llmprotocol.RequiredCapabilities(result.Request).Supports(llmprotocol.CapabilityVideoInput) {
+			t.Fatal("missing video input demand")
+		}
+		var wire chatRequestWire
+		if err := json.Unmarshal(result.Body, &wire); err != nil {
+			t.Fatal(err)
+		}
+		var parts []chatContentWire
+		if err := json.Unmarshal(wire.Messages[0].Content, &parts); err != nil {
+			t.Fatal(err)
+		}
+		if len(parts) != 2 || parts[1].VideoURL == nil || parts[1].VideoURL.URL != url {
+			t.Fatal("video content not preserved")
+		}
+	}
+	for _, source := range []string{"file:///etc/passwd", "data:image/png;base64,AA=="} {
+		body := []byte(`{"model":"auto","messages":[{"role":"user","content":[{"type":"video_url","video_url":{"url":"` + source + `"}}]}]}`)
+		if _, _, _, err := engine.DecodeRequest(llmprotocol.OpenAIChatV1, body); err == nil {
+			t.Fatal("invalid video source accepted")
+		}
+	}
+}
