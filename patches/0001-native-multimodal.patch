+++ b/src/semantic-router/pkg/protocolcodec/codec_openai_chat_video.go
@@ -0,0 +1,39 @@
+package protocolcodec
+
+import (
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"strings"
+)
+
+func decodeChatVideoContent(part chatContentWire) (llmprotocol.Content, error) {
+	if part.VideoURL == nil || part.VideoURL.URL == "" {
+		return llmprotocol.Content{}, llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "video_url_required", "video_url.url is required", nil)
+	}
+	c := llmprotocol.Content{Kind: llmprotocol.ContentVideo, URL: part.VideoURL.URL, Cache: decodeAnthropicCacheControl(part.CacheControl)}
+	if media, data, ok := decodeDataURL(c.URL); ok {
+		if !strings.HasPrefix(media, "video/") {
+			return llmprotocol.Content{}, llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "video_media_type", "inline video must use a video media type", nil)
+		}
+		c.URL = ""
+		c.MediaType = media
+		c.Data = data
+	}
+	return c, nil
+}
+func (state *chatMessageEncodingState) appendVideo(c llmprotocol.Content) error {
+	if c.FileID != "" {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "video_file_id", "video_url cannot represent file IDs", nil)
+	}
+	source := c.URL
+	if c.Data != "" {
+		if !strings.HasPrefix(c.MediaType, "video/") {
+			return llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "video_media_type", "inline video must use a video media type", nil)
+		}
+		source = "data:" + c.MediaType + ";base64," + c.Data
+	}
+	if source == "" {
+		return llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "video_source", "video requires a URL or inline data", nil)
+	}
+	state.parts = append(state.parts, chatContentWire{Type: "video_url", VideoURL: &chatVideoURLWire{URL: source}, CacheControl: encodeAnthropicCacheControl(c.Cache)})
+	return nil
+}
