@@ -0,0 +1,68 @@
+package llmprotocol
+
+import (
+	"math"
+	"strings"
+)
+
+// AudioGenerationOptions describes prompt-conditioned audio diffusion. It is
+// neither speech synthesis nor the audio output of a Chat request.
+type AudioGenerationOptions struct {
+	Input             string   `json:"input"`
+	ResponseFormat    string   `json:"response_format,omitempty"`
+	Speed             *float64 `json:"speed,omitempty"`
+	StreamFormat      string   `json:"stream_format,omitempty"`
+	AudioLength       *float64 `json:"audio_length,omitempty"`
+	AudioStart        *float64 `json:"audio_start,omitempty"`
+	NegativePrompt    *string  `json:"negative_prompt,omitempty"`
+	GuidanceScale     *float64 `json:"guidance_scale,omitempty"`
+	NumInferenceSteps *int64   `json:"num_inference_steps,omitempty"`
+	Seed              *int64   `json:"seed,omitempty"`
+}
+
+func ValidateAudioGeneration(request Request) error {
+	a := request.AudioGeneration
+	if a == nil {
+		return nil
+	}
+	invalid := func(message string) error {
+		return NewError(ErrorInvalidRequest, "invalid_audio_generation", message, nil)
+	}
+	if strings.TrimSpace(a.Input) == "" {
+		return invalid("audio generation input is required")
+	}
+	if request.SpeechGeneration != nil || request.ImageGeneration != nil || len(request.Tools) != 0 || len(request.Instructions) != 0 ||
+		len(request.Messages) != 1 || request.Messages[0].Role != RoleUser || len(request.Messages[0].Content) != 1 ||
+		request.Messages[0].Content[0].Kind != ContentText || request.Messages[0].Content[0].Text != a.Input {
+		return invalid("audio generation requires its own prompt without chat instructions or other tasks")
+	}
+	if request.Sampling.MaxOutputTokens != nil || request.Sampling.AutomaticOutput {
+		return invalid("audio diffusion does not use a text output token budget")
+	}
+	switch a.ResponseFormat {
+	case "", "wav", "pcm", "flac", "mp3", "opus":
+	default:
+		return invalid("unsupported generated audio format")
+	}
+	if a.StreamFormat != "" && a.StreamFormat != "audio" {
+		return invalid("audio generation supports stream_format audio only")
+	}
+	for _, value := range []*float64{a.Speed, a.AudioLength, a.AudioStart, a.GuidanceScale} {
+		if value != nil && (math.IsNaN(*value) || math.IsInf(*value, 0)) {
+			return invalid("audio generation values must be finite")
+		}
+	}
+	if a.Speed != nil && (*a.Speed < .25 || *a.Speed > 4) {
+		return invalid("speed must be between 0.25 and 4")
+	}
+	if a.AudioLength != nil && *a.AudioLength <= 0 {
+		return invalid("audio_length must be positive")
+	}
+	if a.GuidanceScale != nil && (*a.GuidanceScale < 0 || *a.GuidanceScale > 1000) {
+		return invalid("guidance_scale must be between 0 and 1000")
+	}
+	if a.NumInferenceSteps != nil && (*a.NumInferenceSteps < 1 || *a.NumInferenceSteps > 1000) {
+		return invalid("num_inference_steps must be between 1 and 1000")
+	}
+	return nil
+}
