--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/codec_openai_chat_output_test.go
@@ -0,0 +1,57 @@
+package protocolcodec
+
+import (
+	"encoding/json"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"testing"
+)
+
+func TestNativeChatMixedOutputIsOneTypedModelRequest(t *testing.T) {
+	engine := NewBuiltinEngine()
+	body := []byte(`{"model":"auto","messages":[{"role":"user","content":[{"type":"text","text":"Describe and speak"},{"type":"input_audio","input_audio":{"format":"wav","data":"YQ=="}}]}],"modalities":["text","audio"],"audio":{"format":"wav","voice":"model-specific-voice"},"max_completion_tokens":32}`)
+	request, envelope, _, err := engine.DecodeRequestForMutation(llmprotocol.OpenAIChatV1, body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if request.ChatOutput == nil || !request.ChatOutput.HasAudio() || request.SpeechGeneration != nil {
+		t.Fatal("mixed output became a separate task")
+	}
+	required := llmprotocol.RequiredCapabilities(request)
+	if !required.Supports(llmprotocol.CapabilityAudioInput) || !required.Supports(llmprotocol.CapabilityAudioOutput) {
+		t.Fatal("lost input/output requirements")
+	}
+	declared, _ := llmprotocol.ModelCapabilities([]string{"text", "audio_input"})
+	if declared.Contains(required.TaskCapabilities()) {
+		t.Fatal("audio input model qualified for audio output")
+	}
+	request.Model, request.Generation = "chosen-model", request.Generation+1
+	encoded, err := engine.EncodeRequest(llmprotocol.OpenAIChatV1, request, envelope)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire chatRequestWire
+	if err := json.Unmarshal(encoded.Body, &wire); err != nil {
+		t.Fatal(err)
+	}
+	if wire.Model != "chosen-model" || len(wire.Modalities) != 2 || wire.Audio.Voice != "model-specific-voice" || wire.Audio.Format != "wav" {
+		t.Fatal(string(encoded.Body))
+	}
+	for _, target := range []llmprotocol.WireFormat{llmprotocol.OpenAISpeechV1, llmprotocol.OpenAIResponsesV1, llmprotocol.AnthropicMessagesV1} {
+		if _, err := engine.EncodeRequest(target, request, envelope); err == nil {
+			t.Fatalf("native Chat output silently converted to %s", target)
+		}
+	}
+}
+func TestNativeChatOutputValidationAndDefaults(t *testing.T) {
+	engine := NewBuiltinEngine()
+	base := `{"model":"auto","messages":[{"role":"user","content":"hi"}],`
+	for _, tail := range []string{`"modalities":[]`, `"modalities":["audio","audio"]`, `"modalities":["video"]`, `"audio":{"format":"wav"}`, `"modalities":["text"],"audio":{"format":"wav"}`, `"modalities":["audio"],"audio":{"format":"bad"}`, `"modalities":["audio"],"audio":{"unexpected":true}`} {
+		if _, _, _, err := engine.DecodeRequest(llmprotocol.OpenAIChatV1, []byte(base+tail+`}`)); err == nil {
+			t.Fatalf("accepted invalid %s", tail)
+		}
+	}
+	request, _, _, err := engine.DecodeRequest(llmprotocol.OpenAIChatV1, []byte(base+`"modalities":["audio"]}`))
+	if err != nil || request.ChatOutput.Audio != nil {
+		t.Fatalf("invented provider audio defaults: %+v %v", request.ChatOutput, err)
+	}
+}
