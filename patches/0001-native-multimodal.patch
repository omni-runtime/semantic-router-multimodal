diff --git a/src/semantic-router/pkg/protocolcodec/speech_codec.go b/src/semantic-router/pkg/protocolcodec/speech_codec.go
new file mode 100644
index 000000000..0fa3cd3b7
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/speech_codec.go
@@ -0,0 +1,113 @@
+package protocolcodec
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"reflect"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+// SpeechCodec decodes synthesis input directly into neutral semantics. Binary
+// and SSE HTTP responses use same-wire ExtProc passthrough, never Chat framing.
+type SpeechCodec struct{ OpenAIChatCodec }
+
+func (SpeechCodec) Format() llmprotocol.WireFormat { return llmprotocol.OpenAISpeechV1 }
+func (SpeechCodec) Stateless() bool                { return true }
+func (SpeechCodec) Capabilities() llmprotocol.CapabilitySet {
+	return llmprotocol.Capabilities(llmprotocol.CapabilityText,
+		llmprotocol.CapabilitySpeechGeneration, llmprotocol.CapabilityAudioOutput,
+		llmprotocol.CapabilityStreaming)
+}
+
+var reflectSpeechWireType = reflect.TypeOf(speechRequestWire{})
+
+type speechRequestWire struct {
+	Model  string `json:"model"`
+	Stream bool   `json:"stream,omitempty"`
+	llmprotocol.SpeechGenerationOptions
+}
+
+func (SpeechCodec) DecodeRequest(body []byte, policy llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	var wire speechRequestWire
+	if err := decodeWire(body, &wire, policy); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	// Unknown fields are never acceptable on this mutation boundary, even if
+	// a caller supplied a replay-permissive policy to the standalone codec.
+	if err := validateExactJSONFieldNames(body, reflectSpeechWireType); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil,
+			llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "unknown_speech_field", "unsupported speech field", err)
+	}
+	request := llmprotocol.Request{Generation: 1, Model: wire.Model,
+		Stream: wire.Stream || wire.StreamFormat != "", SpeechGeneration: &wire.SpeechGenerationOptions,
+		Messages: []llmprotocol.Message{{Role: llmprotocol.RoleUser,
+			Content: []llmprotocol.Content{{Kind: llmprotocol.ContentText, Text: wire.Input}}}},
+	}
+	request.Sampling.MaxOutputTokens = wire.MaxNewTokens
+	if err := llmprotocol.ValidateSpeechGeneration(request); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	return request, llmprotocol.Envelope{}, nil, nil
+}
+
+func (SpeechCodec) EncodeRequest(request llmprotocol.Request, _ llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if request.SpeechGeneration == nil {
+		return nil, nil, ValidateMediaTask(request, llmprotocol.OpenAISpeechV1)
+	}
+	if err := llmprotocol.ValidateSpeechGeneration(request); err != nil {
+		return nil, nil, err
+	}
+	options := *request.SpeechGeneration
+	options.MaxNewTokens = request.Sampling.MaxOutputTokens
+	body, err := json.Marshal(speechRequestWire{Model: request.Model, Stream: request.Stream,
+		SpeechGenerationOptions: options})
+	return body, nil, err
+}
+
+func (SpeechCodec) DecodeResponse(body []byte, policy llmprotocol.Policy) (llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	if len(body) == 0 || len(body) > policy.Limits.BodyBytes {
+		return llmprotocol.Response{}, llmprotocol.Envelope{}, nil, fmt.Errorf("speech response exceeds buffered codec limit")
+	}
+	id := fmt.Sprintf("speech-%x", sha256.Sum256(body))
+	return llmprotocol.Response{Generation: 1, ID: id, Usage: llmprotocol.Usage{State: llmprotocol.UsageUnavailable}, StopReason: llmprotocol.StopEndTurn,
+		Output: []llmprotocol.OutputItem{{ID: id + "-audio", Role: llmprotocol.RoleAssistant,
+			Content: []llmprotocol.Content{{Kind: llmprotocol.ContentAudio, MediaType: "application/octet-stream",
+				Data: base64.StdEncoding.EncodeToString(body)}}}}}, llmprotocol.Envelope{}, nil, nil
+}
+
+func (SpeechCodec) EncodeResponse(response llmprotocol.Response, _ llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if len(response.Output) != 1 || len(response.Output[0].Content) != 1 ||
+		response.Output[0].Content[0].Kind != llmprotocol.ContentAudio {
+		return nil, nil, fmt.Errorf("speech response requires one audio item")
+	}
+	body, err := base64.StdEncoding.DecodeString(response.Output[0].Content[0].Data)
+	return body, nil, err
+}
+
+// Speech streams remain opaque at ExtProc's same-wire transport boundary.
+// Cross-protocol event conversion must not inherit the embedded Chat codec.
+func (SpeechCodec) NewDecoder(_ llmprotocol.StreamContext, _ llmprotocol.Policy) llmprotocol.StreamDecoder {
+	return speechStreamDecoder{}
+}
+func (SpeechCodec) NewEncoder(_ llmprotocol.StreamContext, _ llmprotocol.Policy) llmprotocol.StreamEncoder {
+	return speechStreamEncoder{}
+}
+
+type speechStreamDecoder struct{}
+type speechStreamEncoder struct{}
+
+func (speechStreamDecoder) Push([]byte) ([]llmprotocol.Event, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("speech streams require same-wire transport")
+}
+func (speechStreamDecoder) Finalize(error) ([]llmprotocol.Event, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("speech streams require same-wire transport")
+}
+func (speechStreamEncoder) Push(llmprotocol.Event) ([][]byte, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("speech streams require same-wire transport")
+}
+func (speechStreamEncoder) Finalize(error) ([][]byte, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("speech streams require same-wire transport")
+}
