+func TestNativeSpeechIngressAndContentType(t *testing.T) {
+	r := &OpenAIRouter{}
+	ctx := &RequestContext{Headers: map[string]string{"content-type": "application/json; charset=utf-8"}}
+	detectSourceFormat("/v1/audio/speech?trace=1", ctx)
+	if ctx.SourceFormat != llmprotocol.OpenAISpeechV1 {
+		t.Fatal("speech was classified as chat")
+	}
+	if resp := r.validateRequestHeaders("POST", "/v1/audio/speech"); resp != nil {
+		t.Fatal("speech endpoint rejected")
+	}
+	if resp := r.validateMediaContentType(ctx); resp != nil {
+		t.Fatal("valid content type rejected")
+	}
+	ctx.Headers["content-type"] = "audio/wav"
+	if resp := r.validateMediaContentType(ctx); resp == nil || resp.GetImmediateResponse().GetStatus().GetCode() != 415 {
+		t.Fatal("incorrect content type accepted")
+	}
+}
