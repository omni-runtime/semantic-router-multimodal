+	result, err := engine.TranslateRequest(llmprotocol.OpenAIImagesV1, llmprotocol.OpenAIImagesV1,
+		[]byte(`{"model":"auto","prompt":"x"}`), func(r *llmprotocol.Request) error { r.Model = "selected"; r.Generation++; return nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire map[string]any
+	if err := json.Unmarshal(result.Body, &wire); err != nil {
+		t.Fatal(err)
+	}
+	if _, present := wire["size"]; present {
+		t.Fatal("native model's default size was overridden")
+	}
