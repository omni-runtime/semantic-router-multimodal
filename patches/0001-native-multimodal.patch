+func TestNativeRealtimeDispatchUsesHeadersAndPreservesBoundModel(t *testing.T) {
+	for _, format := range []llmprotocol.WireFormat{llmprotocol.VLLMRealtimeV1, llmprotocol.OmniSpeechStreamV1} {
+		r, model := routingTestRouterForFormat(llmprotocol.OpenAIChatV1)
+		p := r.Config.ModelConfig[model]
+		p.APIFormat = config.APIFormatRealtime
+		p.Capabilities = []string{"text", "realtime", "audio_input", "audio_output", "speech_generation"}
+		if format == llmprotocol.OmniSpeechStreamV1 {
+			p.APIFormat = config.APIFormatSpeechStream
+		}
+		r.Config.ModelConfig[model] = p
+		query := "model=auto"
+		if format == llmprotocol.VLLMRealtimeV1 {
+			query += "&sr_input=audio&sr_output=text%2Caudio"
+		}
+		request, _, _, err := (protocolcodec.RealtimeCodec{Protocol: format}).DecodeRequest([]byte(query), llmprotocol.DefaultPolicy())
+		if err != nil {
+			t.Fatal(err)
+		}
+		ctx := routingTestContext(format, &request)
+		ctx.ExpectStreamingResponse = true
+		dispatch, err := r.prepareProviderDispatch(&request, model, "", false, ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		response, err := r.finalizeProviderDispatchResponse(dispatch, r.buildProviderDispatchResponse(dispatch, ctx), ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		common := response.GetRequestHeaders().GetResponse()
+		if common == nil || common.BodyMutation != nil || !common.ClearRouteCache || response.ModeOverride.RequestBodyMode != http_ext.ProcessingMode_NONE || response.ModeOverride.ResponseBodyMode != http_ext.ProcessingMode_NONE {
+			t.Fatalf("handshake body/frame processing enabled: %v", response)
+		}
+		h := headerValuesByName(common.HeaderMutation.SetHeaders)
+		if h[":path"] != requestWirePath(format)+"?model=provider-model" || h["x-selected-model"] != model {
+			t.Fatalf("provider binding lost: %v", h)
+		}
+		ctx.UpstreamStatusCode = 101
+		h = headerValuesByName(r.handleRealtimeResponseHeaders(ctx).GetResponseHeaders().GetResponse().HeaderMutation.SetHeaders)
+		if h["x-vsr-realtime-provider-model"] != "provider-model" {
+			t.Fatal("native client frame model unavailable")
+		}
+		if _, err := r.eligibleRequestModelRefs(&config.CandidateRequirements{Capabilities: config.CandidateCapabilitiesDeclared}, []config.ModelRef{{Model: model}}, testNeutralRequest("auto", "chat"), nil); !errors.Is(err, selection.ErrNoEligibleCandidates) {
+			t.Fatalf("Chat routed to realtime: %v", err)
+		}
+		p.Capabilities = []string{"text", "audio_input", "audio_output"}
+		r.Config.ModelConfig[model] = p
+		if _, err := r.eligibleRequestModelRefs(&config.CandidateRequirements{Capabilities: config.CandidateCapabilitiesDeclared}, []config.ModelRef{{Model: model}}, &request, nil); !errors.Is(err, selection.ErrNoEligibleCandidates) {
+			t.Fatalf("undeclared realtime model selected: %v", err)
+		}
+	}
+}
