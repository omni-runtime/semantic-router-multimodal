new file mode 100644
index 000000000..c275892d9
--- /dev/null
+++ b/src/semantic-router/pkg/config/media_bindings.go
@@ -0,0 +1,48 @@
+package config
+
+import (
+	"fmt"
+	"net"
+	"strings"
+)
+
+// MediaBindingStoreConfig configures the existing Redis-backed scoped TTL
+// store for native asynchronous media jobs. No inference content is stored.
+type MediaBindingStoreConfig struct {
+	Address       string `yaml:"address"`
+	PasswordEnv   string `yaml:"password_env,omitempty"`
+	Database      int    `yaml:"database,omitempty"`
+	TLS           bool   `yaml:"tls,omitempty"`
+	TTLSeconds    int    `yaml:"ttl_seconds"`
+	MaxTotalBytes int    `yaml:"max_total_bytes"`
+	// Instances maps a model alias to a stable single-instance identity.
+	// Load-balanced instances without shared native job state are unsupported.
+	Instances map[string]string `yaml:"instances"`
+}
+
+func validateMediaBindingContracts(cfg *RouterConfig) error {
+	c := cfg.MediaBindings
+	if c == nil {
+		return nil
+	}
+	if _, _, err := net.SplitHostPort(c.Address); err != nil {
+		return fmt.Errorf("global.stores.media_bindings.address requires host:port")
+	}
+	if c.Database < 0 || c.TTLSeconds < 60 || c.TTLSeconds > 604800 || c.MaxTotalBytes < 65536 || len(c.Instances) == 0 {
+		return fmt.Errorf("media_bindings requires database >= 0, TTL 60..604800 seconds, >= 65536 bytes and explicit instances")
+	}
+	for model, instance := range c.Instances {
+		if strings.TrimSpace(instance) == "" || len(instance) > 128 || strings.ContainsAny(instance, "\x00\r\n") {
+			return fmt.Errorf("media_bindings instance for %q is invalid", model)
+		}
+		if cfg.GetModelAPIFormat(model) != APIFormatVideo || len(cfg.GetEndpointsForModel(model)) != 1 {
+			return fmt.Errorf("media_bindings model %q requires video format and exactly one concrete backend", model)
+		}
+	}
+	for model := range cfg.ModelConfig {
+		if cfg.GetModelAPIFormat(model) == APIFormatVideo && c.Instances[model] == "" {
+			return fmt.Errorf("media_bindings must identify the instance for video model %q", model)
+		}
+	}
+	return nil
+}
