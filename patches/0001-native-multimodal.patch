+	params := r.Config.ModelConfig[model]
+	params.APIFormat = config.APIFormatImages
+	params.Capabilities = []string{"text", "image_generation"}
+	r.Config.ModelConfig[model] = params
+	ctx = routingTestContext(llmprotocol.OpenAIImagesV1, &request)
+	dispatch, err := r.prepareProviderDispatch(&request, model, "", false, ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if dispatch.targetFormat != llmprotocol.OpenAIImagesV1 || requestWirePath(dispatch.targetFormat) != "/v1/images/generations" {
+		t.Fatal("wrong image protocol")
+	}
+	body, err := r.encodeDispatchRequest(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var wire map[string]any
+	if err := json.Unmarshal(body, &wire); err != nil {
+		t.Fatal(err)
