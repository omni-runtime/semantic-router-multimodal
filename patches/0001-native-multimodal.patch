@@ -0,0 +1,27 @@
+package selection
+
+import (
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func TestNativeImageBudgetChecksPromptWithoutInventingOutputTokens(t *testing.T) {
+	r := &llmprotocol.Request{ImageGeneration: &llmprotocol.ImageGenerationOptions{Native: &llmprotocol.NativeImageGenerationOptions{}},
+		Messages: []llmprotocol.Message{{Role: llmprotocol.RoleUser, Content: []llmprotocol.Content{{Kind: llmprotocol.ContentText, Text: "draw"}}}}}
+	demand := DemandForRequest(r)
+	requirements := &config.CandidateRequirements{Capabilities: config.CandidateCapabilitiesDeclared, Context: config.CandidateContextKnownLimits}
+	model := config.ModelParams{Capabilities: []string{"text", "image_generation"}, ContextWindowSize: 128}
+	if err := ValidateCandidateRequirements(requirements, "image", model, demand); err != nil {
+		t.Fatal(err)
+	}
+	demand.InputTokens = 129
+	if err := ValidateCandidateRequirements(requirements, "image", model, demand); err == nil {
+		t.Fatal("oversized image prompt ignored the model context bound")
+	}
+	r.ImageGeneration.Native = nil
+	if err := ValidateCandidateRequirements(requirements, "hosted", model, DemandForRequest(r)); err == nil {
+		t.Fatal("a hosted image tool in a text request still needs its text output budget")
