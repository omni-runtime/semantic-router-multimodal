+func TestNativeRealtimeHeaderFlowRunsOneNativeAlgorithmWithoutMessages(t *testing.T) {
+	cfg, err := config.ParseYAMLBytes([]byte(`
+version: v0.3
+providers:
+  models:
+    - name: chat
+      api_format: openai
+      backend_refs: [{provider: vllm, endpoint: '127.0.0.1:8000', api_key: fixture}]
+    - name: realtime-a
+      provider_model_id: native-a
+      api_format: realtime
+      backend_refs: [{provider: vllm, endpoint: '127.0.0.1:8001', api_key: fixture}]
+    - name: realtime-b
+      provider_model_id: native-b
+      api_format: realtime
+      backend_refs: [{provider: vllm, endpoint: '127.0.0.1:8002', api_key: fixture}]
+routing:
+  candidate_requirements: {capabilities: declared, context: known_limits}
+  modelCards:
+    - {name: chat, capabilities: [text], context_window_size: 2048, max_output_tokens: 512}
+    - {name: realtime-a, capabilities: [text, audio_input, realtime], context_window_size: 2048}
+    - {name: realtime-b, capabilities: [text, audio_input, realtime], context_window_size: 2048}
+  decisions:
+    - name: native-session
+      priority: 1
+      rules: {operator: AND, conditions: []}
+      algorithm: {type: static}
+      modelRefs: [{model: chat}, {model: realtime-a}, {model: realtime-b}]
+global:
+  router:
+    auto_model_names: [auto]
+    require_entrypoint: true
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	classifier, err := classification.NewClassifier(cfg, nil, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	counter := &realtimeCountingSelector{Selector: selection.NewStaticSelector(nil)}
+	registry := selection.NewRegistry()
+	registry.Register(selection.MethodStatic, counter)
+	router := &OpenAIRouter{Config: cfg, Classifier: classifier, ModelSelector: registry, CredentialResolver: newTestCredentialResolver(cfg)}
+	ctx := routingTestContext(llmprotocol.OpenAIChatV1, nil)
+	h := map[string]string{":method": "GET", ":path": "/v1/realtime?model=auto&sr_input=audio&sr_output=text", "upgrade": "websocket", "connection": "Upgrade", "sec-websocket-version": "13", "sec-websocket-key": "dGhlIHNhbXBsZSBub25jZQ=="}
+	headerMap := &core.HeaderMap{}
+	for key, value := range h {
+		headerMap.Headers = append(headerMap.Headers, &core.HeaderValue{Key: key, RawValue: []byte(value)})
+	}
+	response, err := router.handleRequestHeaders(&ext_proc.ProcessingRequest_RequestHeaders{RequestHeaders: &ext_proc.HttpHeaders{Headers: headerMap}}, ctx)
+	if err != nil || response.GetRequestHeaders() == nil {
+		t.Fatalf("handshake failed: %v %v", response, err)
+	}
+	if counter.calls != 1 || len(ctx.SemanticRequest.Messages) != 0 || ctx.VSRSelectedModel == "chat" || ctx.VSRSelectedModel == "" {
+		t.Fatalf("handshake bypassed native algorithm or fabricated prompt: calls=%d model=%s", counter.calls, ctx.VSRSelectedModel)
+	}
+	ctx.UpstreamStatusCode = 101
+	router.handleRealtimeResponseHeaders(ctx)
+	if counter.calls != 1 {
+		t.Fatal("response repeated selection")
+	}
+}
