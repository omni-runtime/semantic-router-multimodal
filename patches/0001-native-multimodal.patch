diff --git a/src/semantic-router/pkg/extproc/processor_video_binding.go b/src/semantic-router/pkg/extproc/processor_video_binding.go
new file mode 100644
index 000000000..a056c2399
--- /dev/null
+++ b/src/semantic-router/pkg/extproc/processor_video_binding.go
@@ -0,0 +1,141 @@
+package extproc
+
+import (
+	"context"
+	"crypto/sha256"
+	"crypto/tls"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/contextcompression"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+// videoBinding stores protocol ownership, never prompts, uploaded media or
+// credentials. Each ID points to exactly one unchanged provider instance.
+type videoBinding struct {
+	Model       string            `json:"model"`
+	Recipe      config.RecipeName `json:"recipe"`
+	Fingerprint string            `json:"fingerprint"`
+	ProviderID  string            `json:"provider_id"`
+}
+
+type videoRequestBinding struct {
+	binding   videoBinding
+	entry     contextcompression.RecoveryEntry
+	operation string
+	publicID  string
+}
+
+var providerVideoID = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+
+// Dispatch failures are HTTP protocol outcomes, not ExtProc stream failures.
+// Sending a gRPC error here would make Envoy return an empty generic HTTP 500.
+type videoBindingDispatchError struct {
+	code    int
+	message string
+}
+
+func (e *videoBindingDispatchError) Error() string { return e.message }
+
+func videoOwnerScope(ctx *RequestContext) (string, error) {
+	// Authentication belongs to the existing gateway/authz boundary. A request
+	// must carry that verified credential, not a caller-supplied tenant header.
+	authorization := headerValueCI(ctx, "authorization")
+	if strings.TrimSpace(authorization) == "" {
+		return "", errors.New("authenticated Authorization is required for video tasks")
+	}
+	return fmt.Sprintf("%x", sha256.Sum256([]byte("media-job-owner-v1\x00"+authorization))), nil
+}
+
+func (r *OpenAIRouter) mediaBindingStore() (contextcompression.RecoveryStore, error) {
+	r.mediaBindingsMu.Lock()
+	defer r.mediaBindingsMu.Unlock()
+	if r.Config == nil || r.Config.MediaBindings == nil {
+		return nil, errors.New("asynchronous media bindings are disabled")
+	}
+	if r.MediaBindings != nil {
+		return r.MediaBindings, nil
+	}
+	c := r.Config.MediaBindings
+	password := ""
+	if c.PasswordEnv != "" {
+		password = os.Getenv(c.PasswordEnv)
+		if password == "" {
+			return nil, errors.New("media binding credential is unavailable")
+		}
+	}
+	var tlsConfig *tls.Config
+	if c.TLS {
+		tlsConfig = &tls.Config{MinVersion: tls.VersionTLS12}
+	}
+	store, err := contextcompression.NewRedisRecoveryStore(contextcompression.RedisRecoveryStoreOptions{
+		Address: c.Address, Password: password, Database: c.Database, TLSConfig: tlsConfig,
+		KeyPrefix: "vsr:media-binding:v1:", MaxTotalBytes: c.MaxTotalBytes,
+	})
+	if err == nil {
+		r.MediaBindings = store
+	}
+	return store, err
+}
+
+func mediaStoreContext(ctx *RequestContext) (context.Context, context.CancelFunc) {
+	return context.WithTimeout(selectionRequestContext(ctx), 2*time.Second)
+}
+
+func (r *OpenAIRouter) videoRouteFingerprint(dispatch *providerDispatch, recipe *config.RoutingRecipe) (string, error) {
+	if r.Config.MediaBindings == nil || recipe == nil || !r.Config.IsRecipeReachableForRouting(recipe.Name) {
+		return "", errors.New("video task requires a reachable public recipe")
+	}
+	instance := r.Config.MediaBindings.Instances[dispatch.logicalModel]
+	if instance == "" || len(r.Config.GetEndpointsForModel(dispatch.logicalModel)) != 1 || dispatch.targetFormat != llmprotocol.OmniVideoV1 {
+		return "", errors.New("video task requires one explicitly identified provider instance")
+	}
+	data, err := json.Marshal(struct {
+		Model, Backend, Address, Instance, NativeModel string
+		Profile                                        *config.ProviderProfile
+		Recipe                                         *config.RoutingRecipe
+	}{dispatch.logicalModel, dispatch.backendName, dispatch.backendAddress, instance, dispatch.upstreamModel, dispatch.profile, recipe})
+	if err != nil {
+		return "", err
+	}
+	return fmt.Sprintf("%x", sha256.Sum256(data)), nil
+}
+
+func (r *OpenAIRouter) prepareVideoBinding(dispatch *providerDispatch, ctx *RequestContext) error {
+	owner, err := videoOwnerScope(ctx)
+	if err != nil {
+		return &videoBindingDispatchError{401, err.Error()}
+	}
+	fingerprint, err := r.videoRouteFingerprint(dispatch, ctx.Routing.SelectedRecipe())
+	if err != nil {
+		return &videoBindingDispatchError{503, err.Error()}
+	}
+	store, err := r.mediaBindingStore()
+	if err != nil {
+		return &videoBindingDispatchError{503, "video binding store unavailable"}
+	}
+	storeCtx, cancel := mediaStoreContext(ctx)
+	defer cancel()
+	id := "video_sr_" + uuid.NewString()
+	now := time.Now()
+	ttl := time.Duration(r.Config.MediaBindings.TTLSeconds) * time.Second
+	binding := videoBinding{Model: dispatch.logicalModel, Recipe: ctx.Routing.RecipeName(), Fingerprint: fingerprint}
+	data, _ := json.Marshal(binding)
+	entry := contextcompression.RecoveryEntry{Key: id, Scope: owner, Content: string(data), CreatedAt: now, ExpiresAt: now.Add(ttl)}
+	// Reserve bounded durable state before any model call. A failed or timed-out
+	// create leaves a TTL-limited incomplete binding, never a replayed request.
+	if err := store.Put(storeCtx, entry, ttl); err != nil {
+		return &videoBindingDispatchError{503, "video binding store unavailable"}
+	}
+	ctx.videoBinding = &videoRequestBinding{binding: binding, entry: entry, operation: "create", publicID: id}
+	return nil
+}
