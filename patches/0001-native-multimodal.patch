+	engine := protocolcodec.NewBuiltinEngine()
+	request, _, _, err := engine.DecodeRequest(llmprotocol.OpenAIImagesV1, []byte(`{"model":"auto","prompt":"a blue square","response_format":"url","seed":7}`))
+	if err != nil {
