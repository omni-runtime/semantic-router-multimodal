+package protocolcodec
+
+import (
+	"encoding/json"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"reflect"
+)
+
+// AudioGenerationCodec uses the locked Omni diffusion-audio contract. Binary
+// response helpers are shared with speech; task semantics remain independent.
+type AudioGenerationCodec struct{ SpeechCodec }
+
+func (AudioGenerationCodec) Format() llmprotocol.WireFormat { return llmprotocol.OmniAudioGenerateV1 }
+func (AudioGenerationCodec) Capabilities() llmprotocol.CapabilitySet {
+	return llmprotocol.Capabilities(llmprotocol.CapabilityText, llmprotocol.CapabilityAudioGeneration, llmprotocol.CapabilityAudioOutput)
+}
+
+type audioGenerationWire struct {
+	Model string `json:"model"`
+	llmprotocol.AudioGenerationOptions
+}
+
+func (AudioGenerationCodec) DecodeRequest(body []byte, policy llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	var wire audioGenerationWire
+	if err := decodeWire(body, &wire, policy); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	if err := validateExactJSONFieldNames(body, reflect.TypeOf(wire)); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, invalidRequestTranslation(err)
+	}
+	request := llmprotocol.Request{Generation: 1, Model: wire.Model, AudioGeneration: &wire.AudioGenerationOptions,
+		Messages: []llmprotocol.Message{{Role: llmprotocol.RoleUser, Content: []llmprotocol.Content{{Kind: llmprotocol.ContentText, Text: wire.Input}}}}}
+	if err := llmprotocol.ValidateAudioGeneration(request); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	return request, llmprotocol.Envelope{}, nil, nil
+}
+func (AudioGenerationCodec) EncodeRequest(request llmprotocol.Request, _ llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if err := ValidateMediaTask(request, llmprotocol.OmniAudioGenerateV1); err != nil {
+		return nil, nil, err
+	}
+	if err := llmprotocol.ValidateAudioGeneration(request); err != nil {
+		return nil, nil, err
+	}
+	body, err := json.Marshal(audioGenerationWire{Model: request.Model, AudioGenerationOptions: *request.AudioGeneration})
+	return body, nil, err
+}
