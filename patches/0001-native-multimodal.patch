diff --git a/src/semantic-router/pkg/extproc/processor_media_transport.go b/src/semantic-router/pkg/extproc/processor_media_transport.go
new file mode 100644
index 000000000..31711879a
--- /dev/null
+++ b/src/semantic-router/pkg/extproc/processor_media_transport.go
@@ -0,0 +1,40 @@
+package extproc
+
+import (
+	"mime"
+
+	ext_proc "github.com/envoyproxy/go-control-plane/envoy/service/ext_proc/v3"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func isNativeMediaPassthrough(ctx *RequestContext) bool {
+	return ctx != nil && ctx.SourceFormat == ctx.TargetFormat &&
+		(isNativeMediaFormat(ctx.SourceFormat) ||
+			(ctx.SourceFormat == llmprotocol.OpenAIChatV1 && ctx.SemanticRequest != nil && ctx.SemanticRequest.ChatOutput.HasAudio()))
+}
+
+func (r *OpenAIRouter) validateMediaContentType(ctx *RequestContext) *ext_proc.ProcessingResponse {
+	if isMultipartFormat(ctx.SourceFormat) {
+		media, params, err := mime.ParseMediaType(headerValueCI(ctx, "content-type"))
+		if err != nil || media != "multipart/form-data" || params["boundary"] == "" {
+			return r.createErrorResponse(415, "this media endpoint requires multipart/form-data with a boundary")
+		}
+		return nil
+	}
+	if !isNativeMediaFormat(ctx.SourceFormat) {
+		return nil
+	}
+	mediaType, _, err := mime.ParseMediaType(headerValueCI(ctx, "content-type"))
+	if err != nil || mediaType != "application/json" {
+		return r.createErrorResponse(415, "this media endpoint requires application/json")
+	}
+	return nil
+}
+
+func isNativeMediaFormat(format llmprotocol.WireFormat) bool {
+	return format == llmprotocol.MLXVideoV1 || isMultipartFormat(format) || format == llmprotocol.OpenAISpeechV1 || format == llmprotocol.OpenAIImagesV1 || format == llmprotocol.OmniAudioGenerateV1
+}
+
+func isMultipartFormat(format llmprotocol.WireFormat) bool {
+	return format == llmprotocol.OmniVideoV1 || format == llmprotocol.OmniVideoSyncV1 || format == llmprotocol.OpenAITranscriptionV1 || format == llmprotocol.OpenAITranslationV1 || format == llmprotocol.OpenAIImageEditV1
+}
