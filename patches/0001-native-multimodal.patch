diff --git a/src/semantic-router/pkg/protocolcodec/realtime_codec.go b/src/semantic-router/pkg/protocolcodec/realtime_codec.go
new file mode 100644
index 000000000..73a9e59d5
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/realtime_codec.go
@@ -0,0 +1,77 @@
+package protocolcodec
+
+import (
+	"fmt"
+	"net/url"
+	"strings"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+// RealtimeCodec projects a WebSocket query into a neutral session request.
+// DecodeRequest's bytes are explicitly the handshake query, never a JSON body.
+// Frames bypass ExtProc after upgrade and cannot enter the HTTP stream codecs.
+type RealtimeCodec struct {
+	SpeechCodec
+	Protocol llmprotocol.WireFormat
+}
+
+func (c RealtimeCodec) Format() llmprotocol.WireFormat { return c.Protocol }
+func (c RealtimeCodec) Capabilities() llmprotocol.CapabilitySet {
+	if c.Protocol == llmprotocol.OmniSpeechStreamV1 {
+		return llmprotocol.Capabilities(llmprotocol.CapabilityRealtime, llmprotocol.CapabilityText,
+			llmprotocol.CapabilitySpeechGeneration, llmprotocol.CapabilityAudioOutput, llmprotocol.CapabilityStreaming)
+	}
+	return llmprotocol.Capabilities(llmprotocol.CapabilityRealtime, llmprotocol.CapabilityText,
+		llmprotocol.CapabilityAudioInput, llmprotocol.CapabilityAudioOutput, llmprotocol.CapabilityStreaming)
+}
+
+func (c RealtimeCodec) DecodeRequest(query []byte, _ llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	bad := func() (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, llmprotocol.NewError(llmprotocol.ErrorInvalidRequest,
+			"invalid_realtime_query", "handshake requires one model; realtime additionally requires sr_input=audio and sr_output=text or text,audio", nil)
+	}
+	if len(query) > 4096 {
+		return bad()
+	}
+	values, err := url.ParseQuery(string(query))
+	if err != nil {
+		return bad()
+	}
+	for name, items := range values {
+		if len(items) != 1 || (name != "model" && (c.Protocol != llmprotocol.VLLMRealtimeV1 || name != "sr_input" && name != "sr_output")) {
+			return bad()
+		}
+	}
+	model := values.Get("model")
+	if model == "" || strings.TrimSpace(model) != model || len(model) > 256 || strings.ContainsAny(model, "\r\n\x00") {
+		return bad()
+	}
+	session := &llmprotocol.RealtimeSession{Format: c.Protocol, AudioOutput: c.Protocol == llmprotocol.OmniSpeechStreamV1}
+	if c.Protocol == llmprotocol.VLLMRealtimeV1 {
+		if values.Get("sr_input") != "audio" || (values.Get("sr_output") != "text" && values.Get("sr_output") != "text,audio") {
+			return bad()
+		}
+		session.AudioOutput = values.Get("sr_output") == "text,audio"
+	}
+	request := llmprotocol.Request{Generation: 1, Model: model, Stream: true, Realtime: session}
+	return request, llmprotocol.Envelope{}, nil, llmprotocol.ValidateRealtime(request)
+}
+
+func (c RealtimeCodec) EncodeRequest(request llmprotocol.Request, _ llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if err := ValidateMediaTask(request, c.Protocol); err != nil {
+		return nil, nil, err
+	}
+	if err := llmprotocol.ValidateRealtime(request); err != nil {
+		return nil, nil, err
+	}
+	// Only the native model query reaches the engine. SR constraints never do.
+	return []byte(url.Values{"model": {request.Model}}.Encode()), nil, nil
+}
+
+func (RealtimeCodec) DecodeResponse([]byte, llmprotocol.Policy) (llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	return llmprotocol.Response{}, llmprotocol.Envelope{}, nil, fmt.Errorf("realtime frames require native WebSocket transport")
+}
+func (RealtimeCodec) EncodeResponse(llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("realtime frames require native WebSocket transport")
+}
diff --git a/src/semantic-router/pkg/protocolcodec/realtime_codec_test.go b/src/semantic-router/pkg/protocolcodec/realtime_codec_test.go
new file mode 100644
index 000000000..ff42a67a0
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/realtime_codec_test.go
@@ -0,0 +1,54 @@
+package protocolcodec
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func TestRealtimeHandshakeRequirementsAndProjection(t *testing.T) {
+	for _, format := range []llmprotocol.WireFormat{llmprotocol.VLLMRealtimeV1, llmprotocol.OmniSpeechStreamV1} {
+		codec := RealtimeCodec{Protocol: format}
+		query := "model=local-only"
+		if format == llmprotocol.VLLMRealtimeV1 {
+			query += "&sr_input=audio&sr_output=text%2Caudio"
+		}
+		request, _, _, err := codec.DecodeRequest([]byte(query), llmprotocol.DefaultPolicy())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(request.Messages) != 0 || !llmprotocol.RequiredCapabilities(request).Supports(llmprotocol.CapabilityRealtime|llmprotocol.CapabilityAudioOutput) {
+			t.Fatal("lost typed session requirements")
+		}
+		request.Model = "engine/model"
+		result, err := NewBuiltinEngine().EncodeRequest(format, request, llmprotocol.Envelope{})
+		if err != nil || string(result.Body) != "model=engine%2Fmodel" {
+			t.Fatalf("native query: %s, %v", result.Body, err)
+		}
+		for _, other := range []llmprotocol.WireFormat{llmprotocol.OpenAIChatV1, llmprotocol.OpenAISpeechV1, llmprotocol.OpenAIImagesV1} {
+			if _, err := NewBuiltinEngine().EncodeRequest(other, request, llmprotocol.Envelope{}); err == nil {
+				t.Fatalf("session silently projected to %s", other)
+			}
+		}
+		request.Messages = []llmprotocol.Message{{Role: llmprotocol.RoleUser, Content: []llmprotocol.Content{{Kind: llmprotocol.ContentText, Text: "injected"}}}}
+		if _, _, err := codec.EncodeRequest(request, llmprotocol.Envelope{}, llmprotocol.DefaultPolicy()); err == nil {
+			t.Fatal("HTTP prompt plugin silently discarded")
+		}
+	}
+}
+
+func TestRealtimeRejectsAmbiguousQueryAndFrameDecoding(t *testing.T) {
+	c := RealtimeCodec{Protocol: llmprotocol.VLLMRealtimeV1}
+	for _, q := range []string{"", "model=auto", "model=auto&model=x&sr_input=audio&sr_output=text", "model=auto&sr_input=video&sr_output=text", "model=auto&sr_input=audio&sr_output=text&max_tokens=5", "model=auto&sr_input=audio&sr_output=audio", "model=%0D&sr_input=audio&sr_output=text", strings.Repeat("x", 4097)} {
+		if _, _, _, err := c.DecodeRequest([]byte(q), llmprotocol.DefaultPolicy()); err == nil {
+			t.Fatalf("invalid query accepted: %q", q)
+		}
+	}
+	if _, _, _, err := c.DecodeResponse([]byte(`{"type":"transcription.delta","delta":"hello"}`), llmprotocol.DefaultPolicy()); err == nil {
+		t.Fatal("native frame decoded as HTTP response")
+	}
+	if _, _, err := c.NewDecoder(llmprotocol.StreamContext{}, llmprotocol.DefaultPolicy()).Push([]byte("data: {}\n\n")); err == nil {
+		t.Fatal("WebSocket frame decoder inherited SSE")
+	}
+}
