index 000000000..b448eb1cd
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/media_task.go
@@ -0,0 +1,46 @@
+package protocolcodec
+
+import "github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+
+// ValidateMediaTask qualifies a native operation before candidate selection.
+// Text input support does not mean that a synthesis wire can generate a chat
+// answer. The same guard is applied again at the final transport projection.
+func ValidateMediaTask(request llmprotocol.Request, target llmprotocol.WireFormat) error {
+	if (request.MLXVideo != nil) != (target == llmprotocol.MLXVideoV1) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "mlx_video_task_required", "MLX video requires its native JSON video task and exact wire", nil)
+	}
+	if request.Realtime != nil && request.Realtime.Format != target || (target == llmprotocol.VLLMRealtimeV1 || target == llmprotocol.OmniSpeechStreamV1) && (request.Realtime == nil || request.Realtime.Format != target) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "realtime_task_required", "realtime sessions require their exact native handshake protocol", nil)
+	}
+
+	if target == llmprotocol.OmniVideoV1 && (request.Multipart == nil || request.Multipart.Task != llmprotocol.TaskVideoCreate) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "video_task_required", "video endpoint requires its native asynchronous video task", nil)
+	}
+	if target == llmprotocol.OmniVideoSyncV1 && (request.Multipart == nil || request.Multipart.Task != llmprotocol.TaskVideoSync) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "video_task_required", "video endpoint requires a native video generation task", nil)
+	}
+	if request.ChatOutput != nil && target != llmprotocol.OpenAIChatV1 {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "native_chat_output_required", "Chat output modalities require the native Chat protocol", nil)
+	}
+	if target == llmprotocol.OpenAIImageEditV1 && (request.Multipart == nil || request.Multipart.Task != llmprotocol.TaskImageEdit) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "multipart_task_required", "endpoint requires its native multipart task", nil)
+	}
+	if target == llmprotocol.OpenAITranslationV1 && (request.Multipart == nil || request.Multipart.Task != llmprotocol.TaskTranslation) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "multipart_task_required", "endpoint requires its native multipart task", nil)
+	}
+	if target == llmprotocol.OpenAITranscriptionV1 && (request.Multipart == nil || request.Multipart.Task != llmprotocol.TaskTranscription) {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "multipart_task_required", "endpoint requires its native multipart task", nil)
+	}
+	if target == llmprotocol.OmniAudioGenerateV1 && request.AudioGeneration == nil {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "audio_generation_task_required", "the audio generation endpoint requires an audio diffusion task", nil)
+	}
+	if target == llmprotocol.OpenAISpeechV1 && request.SpeechGeneration == nil {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "unsupported_capability",
+			"the speech endpoint requires a speech synthesis task", nil)
+	}
+	if target == llmprotocol.OpenAIImagesV1 && request.ImageGeneration == nil {
+		return llmprotocol.NewError(llmprotocol.ErrorUnsupportedFeature, "unsupported_capability",
+			"the images endpoint requires an image generation task", nil)
+	}
+	return nil
+}
diff --git a/src/semantic-router/pkg/protocolcodec/mlx_video_codec.go b/src/semantic-router/pkg/protocolcodec/mlx_video_codec.go
new file mode 100644
index 000000000..1162ab093
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/mlx_video_codec.go
@@ -0,0 +1,54 @@
+package protocolcodec
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"reflect"
+)
+
+// MLXVideoCodec projects only native H3 FL2VA JSON. Responses and progress SSE
+// pass through ExtProc without buffering a full base64 video in the router.
+type MLXVideoCodec struct{ SpeechCodec }
+
+func (MLXVideoCodec) Format() llmprotocol.WireFormat { return llmprotocol.MLXVideoV1 }
+func (MLXVideoCodec) Capabilities() llmprotocol.CapabilitySet {
+	return llmprotocol.Capabilities(llmprotocol.CapabilityText, llmprotocol.CapabilityVideoGeneration, llmprotocol.CapabilityVideoOutput, llmprotocol.CapabilityAudioOutput, llmprotocol.CapabilityImageInput, llmprotocol.CapabilityStreaming)
+}
+
+type mlxVideoWire struct {
+	Model  string `json:"model"`
+	Stream bool   `json:"stream,omitempty"`
+	llmprotocol.MLXVideoOptions
+}
+
+func (MLXVideoCodec) DecodeRequest(body []byte, policy llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	var wire mlxVideoWire
+	if err := decodeWire(body, &wire, policy); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	if err := validateExactJSONFieldNames(body, reflect.TypeOf(wire)); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, invalidRequestTranslation(err)
+	}
+	request := llmprotocol.Request{Generation: 1, Model: wire.Model, Stream: wire.Stream, MLXVideo: &wire.MLXVideoOptions, Messages: []llmprotocol.Message{{Role: llmprotocol.RoleUser, Content: []llmprotocol.Content{{Kind: llmprotocol.ContentText, Text: wire.Prompt}}}}}
+	if err := llmprotocol.ValidateMLXVideo(request); err != nil {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	return request, llmprotocol.Envelope{}, nil, nil
+}
+func (MLXVideoCodec) EncodeRequest(request llmprotocol.Request, _ llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if err := ValidateMediaTask(request, llmprotocol.MLXVideoV1); err != nil {
+		return nil, nil, err
+	}
+	if err := llmprotocol.ValidateMLXVideo(request); err != nil {
+		return nil, nil, err
+	}
+	body, err := json.Marshal(mlxVideoWire{Model: request.Model, Stream: request.Stream, MLXVideoOptions: *request.MLXVideo})
+	return body, nil, err
+}
+func (MLXVideoCodec) DecodeResponse([]byte, llmprotocol.Policy) (llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	return llmprotocol.Response{}, llmprotocol.Envelope{}, nil, fmt.Errorf("MLX video responses require same-wire HTTP passthrough")
+}
+func (MLXVideoCodec) EncodeResponse(llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("MLX video responses require same-wire HTTP passthrough")
+}
