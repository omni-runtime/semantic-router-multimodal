+func (r *OpenAIRouter) handleRealtimeRequestHeaders(method, path string, ctx *RequestContext) (*ext_proc.ProcessingResponse, error) {
+	endpoint, query, _ := strings.Cut(path, "?")
+	var format llmprotocol.WireFormat
+	switch endpoint {
+	case "/v1/realtime":
+		format = llmprotocol.VLLMRealtimeV1
+	case "/v1/audio/speech/stream":
+		format = llmprotocol.OmniSpeechStreamV1
+	default:
+		return nil, nil
+	}
+	ctx.SourceFormat = format
+	if method != "GET" {
+		return r.createErrorResponse(405, "realtime handshake requires GET"), nil
+	}
+	if !strings.EqualFold(headerValueCI(ctx, "upgrade"), "websocket") || !headerContainsToken(headerValueCI(ctx, "connection"), "upgrade") || headerValueCI(ctx, "sec-websocket-version") != "13" {
+		logging.ComponentWarnEvent("extproc", "realtime_upgrade_rejected", map[string]interface{}{"request_id": ctx.RequestID, "upgrade": headerValueCI(ctx, "upgrade"), "connection": headerValueCI(ctx, "connection"), "version": headerValueCI(ctx, "sec-websocket-version")})
+		return r.realtimeError(ctx, 400, "invalid_realtime_upgrade", "valid WebSocket upgrade headers are required"), nil
+	}
+	key, err := base64.StdEncoding.DecodeString(headerValueCI(ctx, "sec-websocket-key"))
+	if err != nil || len(key) != 16 {
+		return r.realtimeError(ctx, 400, "invalid_realtime_key", "invalid WebSocket key"), nil
+	}
+	if length := headerValueCI(ctx, "content-length"); length != "" && length != "0" {
+		return r.realtimeError(ctx, 400, "invalid_realtime_body", "WebSocket handshake must not carry a body"), nil
+	}
+	if headerValueCI(ctx, "transfer-encoding") != "" {
+		return r.realtimeError(ctx, 400, "invalid_realtime_body", "WebSocket handshake must not carry a body"), nil
+	}
+	applyHeaderPassThroughPolicy(ctx)
+	request, envelope, diagnostics, err := (protocolcodec.RealtimeCodec{Protocol: format}).DecodeRequest([]byte(query), llmprotocol.DefaultPolicy())
+	if err != nil {
+		return r.realtimeError(ctx, 400, "invalid_realtime_query", err.Error()), nil
+	}
+	if r.Config != nil && r.Config.RequireEntrypoint && !r.requestModelActsAsAuto(request.Model) {
+		return r.realtimeError(ctx, 400, "realtime_entrypoint_required", "model must name an enabled public entrypoint"), nil
+	}
+	request.Trusted.SourceFormat = format
+	request.Trusted.CorrelationID = ctx.RequestID
+	ctx.SourceFormat = format
+	ctx.SemanticRequest = &request
+	ctx.ProtocolEnvelope = envelope
+	ctx.ProtocolDiagnostics = diagnostics
+	ctx.ExpectStreamingResponse = true
+	ctx.ProcessingStartTime = time.Now()
+	response, err := r.routeSemanticRequest(&request, ctx)
+	if err != nil {
+		if rejected, handled := r.processBodyRoutingError(err, ctx); handled {
+			return rejected, nil
+		}
+		return r.createErrorResponse(503, "realtime handshake routing failed"), nil
+	}
+	return response, nil
+}
+
+func headerContainsToken(value, token string) bool {
+	for _, part := range strings.Split(value, ",") {
+		if strings.EqualFold(strings.TrimSpace(part), token) {
+			return true
+		}
+	}
+	return false
+}
+
+func realtimeProcessingMode() *http_ext.ProcessingMode {
+	return &http_ext.ProcessingMode{RequestBodyMode: http_ext.ProcessingMode_NONE,
+		ResponseBodyMode: http_ext.ProcessingMode_NONE, RequestTrailerMode: http_ext.ProcessingMode_SKIP,
+		ResponseTrailerMode: http_ext.ProcessingMode_SKIP}
+}
+
+func finalizeRealtimeDispatch(dispatch *providerDispatch, response *ext_proc.ProcessingResponse, query []byte, ctx *RequestContext) (*ext_proc.ProcessingResponse, error) {
+	common := response.GetRequestBody().GetResponse()
+	if common == nil {
+		return nil, fmt.Errorf("realtime provider dispatch is unavailable")
+	}
+	if _, err := url.ParseQuery(string(query)); err != nil {
+		return nil, err
+	}
+	if common.HeaderMutation == nil {
+		common.HeaderMutation = &ext_proc.HeaderMutation{}
+	}
+	// buildProviderDispatchResponse already contains the selected backend,
+	// provider credentials and base path. Replace only its handshake path.
+	for _, item := range common.HeaderMutation.SetHeaders {
+		if item.Header.Key == ":path" {
+			item.Header.RawValue = []byte(providerEndpointPath(dispatch.profile, dispatch.targetFormat) + "?" + string(query))
+			item.Header.Value = ""
+		}
+	}
+	common.HeaderMutation.RemoveHeaders = append(common.HeaderMutation.RemoveHeaders, "content-length", "content-type")
+	common.BodyMutation = nil
+	common.ClearRouteCache = true
+	return &ext_proc.ProcessingResponse{Response: &ext_proc.ProcessingResponse_RequestHeaders{
+		RequestHeaders: &ext_proc.HeadersResponse{Response: common}}, ModeOverride: realtimeProcessingMode()}, nil
+}
+
+func (r *OpenAIRouter) handleRealtimeResponseHeaders(ctx *RequestContext) *ext_proc.ProcessingResponse {
+	mutation := buildResponseHeaderMutation(ctx, ctx.UpstreamStatusCode == 101)
+	if ctx.UpstreamStatusCode == 101 {
+		// Native vLLM/Omni frame configuration names the loaded model. A native
+		// client reads this response header and uses it in session.update/config.
+		// SR does not inspect or rewrite any frame after the HTTP upgrade.
+		mutation.SetHeaders = append(mutation.SetHeaders, newHeaderValueOption("x-vsr-realtime-provider-model", ctx.SemanticRequest.Model))
+	}
+	return &ext_proc.ProcessingResponse{Response: &ext_proc.ProcessingResponse_ResponseHeaders{
+		ResponseHeaders: &ext_proc.HeadersResponse{Response: &ext_proc.CommonResponse{
+			Status: ext_proc.CommonResponse_CONTINUE, HeaderMutation: mutation}}}, ModeOverride: realtimeProcessingMode()}
+}
+
+func (r *OpenAIRouter) realtimeError(ctx *RequestContext, status int, code, message string) *ext_proc.ProcessingResponse {
+	ctx.ImmediateProtocolError = llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, code, message, nil)
+	return r.createErrorResponse(status, message)
+}
