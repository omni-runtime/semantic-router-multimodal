+package extproc
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+	"time"
+
+	http_ext "github.com/envoyproxy/go-control-plane/envoy/extensions/filters/http/ext_proc/v3"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/config"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/contextcompression"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+type videoTestStore struct {
+	entries map[string]contextcompression.RecoveryEntry
+	fail    bool
+}
+
+func (s *videoTestStore) Put(_ context.Context, e contextcompression.RecoveryEntry, _ time.Duration) error {
+	if s.fail {
+		return errors.New("store unavailable")
+	}
+	s.entries[e.Scope+e.Key] = e
+	return nil
+}
+func (s *videoTestStore) Get(_ context.Context, scope, key string) (contextcompression.RecoveryEntry, error) {
+	if s.fail {
+		return contextcompression.RecoveryEntry{}, errors.New("store unavailable")
+	}
+	e, ok := s.entries[scope+key]
+	if !ok || time.Now().After(e.ExpiresAt) {
+		return e, contextcompression.ErrRecoveryNotFound
+	}
+	return e, nil
+}
+func (*videoTestStore) InvalidateScope(context.Context, string) (int64, error) { return 0, nil }
+func (*videoTestStore) Health(context.Context) error                           { return nil }
+func (*videoTestStore) Close() error                                           { return nil }
+
+func videoTestRouter(t *testing.T) (*OpenAIRouter, *RequestContext, *providerDispatch, *videoTestStore) {
+	t.Helper()
+	r, model := routingTestRouterForFormat(llmprotocol.OpenAIChatV1)
+	params := r.Config.ModelConfig[model]
+	params.APIFormat = config.APIFormatVideo
+	r.Config.ModelConfig[model] = params
+	r.Config.Recipes = []config.RoutingRecipe{{Name: "local", Profile: config.RoutingProfile{Decisions: []config.Decision{{Name: "route", ModelRefs: []config.ModelRef{{Model: model}}}}}}}
+	r.Config.Entrypoints = []config.EntrypointMapping{{ModelNames: []string{"local-only"}, Recipe: "local"}}
+	r.Config.MediaBindings = &config.MediaBindingStoreConfig{Address: "redis:6379", TTLSeconds: 60, MaxTotalBytes: 65536, Instances: map[string]string{model: "instance-1"}}
+	store := &videoTestStore{entries: map[string]contextcompression.RecoveryEntry{}}
+	r.MediaBindings = store
+	ctx := routingTestContext(llmprotocol.OmniVideoV1, nil)
+	ctx.Headers["authorization"] = "Bearer tenant-a"
+	ctx.Routing.SelectRecipe(&r.Config.Recipes[0])
+	dispatch, err := r.resolveProviderDispatch(model, "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r, ctx, dispatch, store
+}
+
+func TestNativeVideoBindingCreateRestoreWithoutSelection(t *testing.T) {
+	r, ctx, dispatch, store := videoTestRouter(t)
+	if err := r.prepareVideoBinding(dispatch, ctx); err != nil {
+		t.Fatal(err)
+	}
+	ctx.UpstreamStatusCode = 200
+	response := r.handleVideoResponseBody([]byte(`{"id":"video_provider_1","status":"queued","progress":0}`), ctx)
+	var object map[string]any
+	if err := json.Unmarshal(response.GetResponseBody().GetResponse().GetBodyMutation().GetBody(), &object); err != nil {
+		t.Fatal(err)
+	}
+	id, _ := object["id"].(string)
+	if !strings.HasPrefix(id, "video_sr_") || id == "video_provider_1" || object["status"] != "queued" {
+		t.Fatalf("invalid public task: %v", object)
+	}
+	// A second Router has no classifiers or selector. It restores from shared
+	// protocol state and cannot silently execute another selection algorithm.
+	reloaded := &OpenAIRouter{Config: r.Config, CredentialResolver: r.CredentialResolver, MediaBindings: store}
+	for _, operation := range []struct{ method, suffix string }{{"GET", ""}, {"GET", "/content"}, {"DELETE", ""}} {
+		query := routingTestContext(llmprotocol.OpenAIChatV1, nil)
+		query.Headers["authorization"] = "Bearer tenant-a"
+		response := reloaded.handleVideoRequestHeaders(operation.method, "/v1/videos/"+id+operation.suffix, query)
+		if response.GetRequestHeaders() == nil {
+			t.Fatalf("restore failed: %v", response)
+		}
+		foundPath := false
+		for _, h := range response.GetRequestHeaders().GetResponse().GetHeaderMutation().GetSetHeaders() {
+			if h.Header.Key == ":path" {
+				foundPath = string(h.Header.RawValue) == "/v1/videos/video_provider_1"+operation.suffix
+			}
+		}
+		if !foundPath || query.VSRSelectedModel != dispatch.logicalModel || !response.GetRequestHeaders().GetResponse().ClearRouteCache {
+			t.Fatal("bound dispatch was lost")
+		}
+		query.UpstreamStatusCode = 200
+		headers := reloaded.handleVideoResponseHeaders(nil, query)
+		if operation.suffix == "/content" {
+			if headers.ModeOverride.ResponseBodyMode != http_ext.ProcessingMode_STREAMED {
+				t.Fatal("download was buffered")
+			}
+			if reloaded.handleVideoResponseBody([]byte{0, 255, 0}, query).GetResponseBody().GetResponse().BodyMutation != nil {
+				t.Fatal("download changed")
+			}
+		} else {
+			if headers.ModeOverride.ResponseBodyMode != http_ext.ProcessingMode_BUFFERED {
+				t.Fatal("task JSON was not bounded for mutation")
+			}
+			out := reloaded.handleVideoResponseBody([]byte(`{"id":"video_provider_1","status":"completed"}`), query)
+			if !strings.Contains(string(out.GetResponseBody().GetResponse().GetBodyMutation().GetBody()), id) {
+				t.Fatal("public task id changed")
+			}
+		}
+	}
+}
+
+func TestNativeVideoBindingRejectsTenantExpiryChangedInstanceAndStoreFailure(t *testing.T) {
+	r, ctx, dispatch, store := videoTestRouter(t)
+	if err := r.prepareVideoBinding(dispatch, ctx); err != nil {
+		t.Fatal(err)
+	}
+	ctx.UpstreamStatusCode = 200
+	r.handleVideoResponseBody([]byte(`{"id":"video_native","status":"queued"}`), ctx)
+	id := ctx.videoBinding.publicID
+	check := func(owner string, want int) {
+		t.Helper()
+		q := routingTestContext(llmprotocol.OpenAIChatV1, nil)
+		q.Headers["authorization"] = owner
+		got := r.handleVideoRequestHeaders("GET", "/v1/videos/"+id, q)
+		if int(got.GetImmediateResponse().GetStatus().GetCode()) != want {
+			t.Fatalf("expected %d: %v", want, got)
+		}
+	}
+	check("Bearer tenant-b", 404)
+	check("", 401)
+	r.Config.MediaBindings.Instances[dispatch.logicalModel] = "instance-2"
+	check("Bearer tenant-a", 409)
+	r.Config.MediaBindings.Instances[dispatch.logicalModel] = "instance-1"
+	store.fail = true
+	check("Bearer tenant-a", 503)
+	if err := r.prepareVideoBinding(dispatch, ctx); err == nil {
+		t.Fatal("created with unavailable binding store")
+	} else if response, handled := r.processBodyRoutingError(err, ctx); !handled || response.GetImmediateResponse().GetStatus().GetCode() != 503 {
+		t.Fatal("store failure became a gRPC transport error rather than HTTP 503")
+	}
+	store.fail = false
+	for k, e := range store.entries {
+		e.ExpiresAt = time.Now().Add(-time.Second)
+		store.entries[k] = e
+	}
+	check("Bearer tenant-a", 404)
+}
+
+func TestNativeVideoBindingMalformedResponseAndNativeError(t *testing.T) {
+	r, ctx, dispatch, store := videoTestRouter(t)
+	if err := r.prepareVideoBinding(dispatch, ctx); err != nil {
+		t.Fatal(err)
+	}
+	ctx.UpstreamStatusCode = 200
+	for _, body := range []string{`{"status":"queued"}`, `{"id":"../x"}`, `{"id":"a","id":"b"}`, strings.Repeat("x", 65537)} {
+		if r.handleVideoResponseBody([]byte(body), ctx).GetImmediateResponse().GetStatus().GetCode() != 502 {
+			t.Fatal("invalid backend response accepted")
+		}
+	}
+	store.fail = true
+	if r.handleVideoResponseBody([]byte(`{"id":"video_native"}`), ctx).GetImmediateResponse().GetStatus().GetCode() != 503 {
+		t.Fatal("storage commit failure was hidden")
+	}
+	ctx.UpstreamStatusCode = 422
+	if r.handleVideoResponseBody([]byte(`{"detail":"engine rejected"}`), ctx).GetResponseBody().GetResponse().BodyMutation != nil {
+		t.Fatal("native error changed")
+	}
+	if response := r.handleVideoRequestHeaders("GET", "/v1/videos", ctx); response.GetImmediateResponse().GetStatus().GetCode() != 405 {
+		t.Fatal("unsupported list accepted")
+	}
+}
diff --git a/src/semantic-router/pkg/extproc/processor_video_transport.go b/src/semantic-router/pkg/extproc/processor_video_transport.go
new file mode 100644
index 000000000..ce26f37ed
--- /dev/null
+++ b/src/semantic-router/pkg/extproc/processor_video_transport.go
@@ -0,0 +1,169 @@
+package extproc
+
+import (
+	"encoding/json"
+	"errors"
+	"strings"
+	"time"
+
+	http_ext "github.com/envoyproxy/go-control-plane/envoy/extensions/filters/http/ext_proc/v3"
+	ext_proc "github.com/envoyproxy/go-control-plane/envoy/service/ext_proc/v3"
+	"github.com/google/uuid"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/contextcompression"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func (r *OpenAIRouter) handleVideoRequestHeaders(method, path string, ctx *RequestContext) *ext_proc.ProcessingResponse {
+	if strings.HasPrefix(path, "/v1/videos") && strings.Contains(path, "?") {
+		return r.createErrorResponse(400, "video task query parameters are unsupported")
+	}
+	if path == "/v1/videos" {
+		if method != "POST" {
+			return r.createErrorResponse(405, "video collection supports creation only")
+		}
+		if r.Config == nil || r.Config.MediaBindings == nil {
+			return r.createErrorResponse(503, "asynchronous video binding store is not configured")
+		}
+		if _, err := videoOwnerScope(ctx); err != nil {
+			return r.createErrorResponse(401, err.Error())
+		}
+		return nil
+	}
+	if path == "/v1/videos/sync" || !strings.HasPrefix(path, "/v1/videos/") {
+		return nil
+	}
+	parts := strings.Split(strings.TrimPrefix(path, "/v1/videos/"), "/")
+	if len(parts) < 1 || len(parts) > 2 || !strings.HasPrefix(parts[0], "video_sr_") {
+		return r.createErrorResponse(404, "video task not found")
+	}
+	if _, err := uuid.Parse(strings.TrimPrefix(parts[0], "video_sr_")); err != nil {
+		return r.createErrorResponse(404, "video task not found")
+	}
+	operation := "query"
+	if len(parts) == 2 {
+		if parts[1] != "content" {
+			return r.createErrorResponse(404, "video task endpoint not found")
+		}
+		operation = "content"
+		if method != "GET" {
+			return r.createErrorResponse(405, "method not allowed")
+		}
+	} else if method == "DELETE" {
+		operation = "delete"
+	} else if method != "GET" {
+		return r.createErrorResponse(405, "method not allowed")
+	}
+	if length := headerValueCI(ctx, "content-length"); length != "" && length != "0" {
+		return r.createErrorResponse(400, "video task continuation must not have a request body")
+	}
+	if headerValueCI(ctx, "transfer-encoding") != "" {
+		return r.createErrorResponse(400, "video task continuation must not have a request body")
+	}
+	owner, err := videoOwnerScope(ctx)
+	if err != nil {
+		return r.createErrorResponse(401, err.Error())
+	}
+	store, err := r.mediaBindingStore()
+	if err != nil {
+		return r.createErrorResponse(503, "video binding store unavailable")
+	}
+	storeCtx, cancel := mediaStoreContext(ctx)
+	defer cancel()
+	entry, err := store.Get(storeCtx, owner, parts[0])
+	if errors.Is(err, contextcompression.ErrRecoveryNotFound) {
+		return r.createErrorResponse(404, "video task not found or expired")
+	}
+	if err != nil {
+		return r.createErrorResponse(503, "video binding store unavailable")
+	}
+	var binding videoBinding
+	if json.Unmarshal([]byte(entry.Content), &binding) != nil || !providerVideoID.MatchString(binding.ProviderID) {
+		return r.createErrorResponse(409, "video task creation outcome is unavailable")
+	}
+	dispatch, err := r.resolveProviderDispatch(binding.Model, "", false)
+	if err != nil {
+		return r.createErrorResponse(409, "video task backend binding changed")
+	}
+	recipe, exists := r.Config.RecipeByName(binding.Recipe)
+	if !exists {
+		return r.createErrorResponse(409, "video task recipe is unavailable")
+	}
+	fingerprint, err := r.videoRouteFingerprint(dispatch, recipe)
+	if err != nil || fingerprint != binding.Fingerprint {
+		return r.createErrorResponse(409, "video task backend binding changed")
+	}
+	ctx.videoBinding = &videoRequestBinding{binding: binding, entry: entry, operation: operation, publicID: parts[0]}
+	ctx.SourceFormat = llmprotocol.OmniVideoV1
+	ctx.TargetFormat = llmprotocol.OmniVideoV1
+	ctx.RequestModel = dispatch.logicalModel
+	ctx.VSRSelectedModel = dispatch.logicalModel
+	ctx.Routing.SelectRecipe(recipe)
+	state := &routeHeaderState{setHeaders: r.startUpstreamSpanAndInjectHeaders(dispatch, ctx), profile: dispatch.profile, removeHeaders: []string{"content-length", "content-type"}}
+	appendProfileHeaders(&state.setHeaders, dispatch.profile)
+	if response := r.appendProviderCredential(state, dispatch.logicalModel, dispatch.backendName, ctx); response != nil {
+		return response
+	}
+	appendRoutingHeaders(&state.setHeaders, dispatch.logicalModel)
+	upstreamPath := providerEndpointPath(dispatch.profile, llmprotocol.OmniVideoV1) + "/" + binding.ProviderID
+	if operation == "content" {
+		upstreamPath += "/content"
+	}
+	state.setHeaders = append(state.setHeaders, newHeaderValueOption(":path", upstreamPath), newHeaderValueOption("accept-encoding", "identity"))
+	response := newContinueRequestHeadersResponse(&ext_proc.HeaderMutation{SetHeaders: state.setHeaders, RemoveHeaders: state.removeHeaders})
+	response.GetRequestHeaders().GetResponse().ClearRouteCache = true
+	response.ModeOverride = &http_ext.ProcessingMode{RequestBodyMode: http_ext.ProcessingMode_NONE, ResponseBodyMode: http_ext.ProcessingMode_BUFFERED}
+	return response
+}
+
+func (r *OpenAIRouter) handleVideoResponseHeaders(_ *ext_proc.ProcessingRequest_ResponseHeaders, ctx *RequestContext) *ext_proc.ProcessingResponse {
+	// Only task JSON is buffered. Downloads and upstream errors remain native
+	// streams; neither can trigger fallback to a different provider instance.
+	passthrough := ctx.UpstreamStatusCode < 200 || ctx.UpstreamStatusCode >= 300 || ctx.videoBinding.operation == "content"
+	mutation := buildResponseHeaderMutation(ctx, ctx.UpstreamStatusCode >= 200 && ctx.UpstreamStatusCode < 300)
+	if !passthrough {
+		mutation.RemoveHeaders = append(mutation.RemoveHeaders, "content-length")
+	}
+	response := buildResponseHeadersContinueResponse(mutation, passthrough)
+	if !passthrough {
+		response.ModeOverride = &http_ext.ProcessingMode{ResponseBodyMode: http_ext.ProcessingMode_BUFFERED}
+	}
+	return response
+}
+
+func (r *OpenAIRouter) handleVideoResponseBody(body []byte, ctx *RequestContext) *ext_proc.ProcessingResponse {
+	state := ctx.videoBinding
+	if ctx.UpstreamStatusCode < 200 || ctx.UpstreamStatusCode >= 300 || state.operation == "content" {
+		return buildResponseBodyContinueResponse(nil, nil)
+	}
+	if len(body) > 64<<10 || llmprotocol.ValidateJSONObject(body, 16) != nil {
+		return r.createErrorResponse(502, "invalid or oversized video task response")
+	}
+	var object map[string]json.RawMessage
+	if json.Unmarshal(body, &object) != nil {
+		return r.createErrorResponse(502, "invalid video task response")
+	}
+	var providerID string
+	if json.Unmarshal(object["id"], &providerID) != nil || !providerVideoID.MatchString(providerID) {
+		return r.createErrorResponse(502, "video task response has no valid id")
+	}
+	if state.operation == "create" {
+		state.binding.ProviderID = providerID
+		data, _ := json.Marshal(state.binding)
+		state.entry.Content = string(data)
+		store, err := r.mediaBindingStore()
+		if err != nil {
+			return r.createErrorResponse(503, "video task was created but its binding could not be saved; do not automatically retry")
+		}
+		storeCtx, cancel := mediaStoreContext(ctx)
+		defer cancel()
+		if err := store.Put(storeCtx, state.entry, time.Until(state.entry.ExpiresAt)); err != nil {
+			return r.createErrorResponse(503, "video task was created but its binding could not be saved; do not automatically retry")
+		}
+	} else if providerID != state.binding.ProviderID {
+		return r.createErrorResponse(502, "video task response id does not match its binding")
+	}
+	object["id"], _ = json.Marshal(state.publicID)
+	encoded, _ := json.Marshal(object)
+	return buildResponseBodyContinueResponse(&ext_proc.BodyMutation{Mutation: &ext_proc.BodyMutation_Body{Body: encoded}}, nil)
+}
