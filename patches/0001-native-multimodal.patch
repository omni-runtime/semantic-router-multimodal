@@ -0,0 +1,90 @@
+package protocolcodec
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func TestSpeechCodecPreservesSynthesisParametersAcrossModelSelection(t *testing.T) {
+	for _, format := range []string{"wav", "mp3", "pcm", "opus", "flac"} {
+		t.Run(format, func(t *testing.T) {
+			body := []byte(fmt.Sprintf(`{"model":"local-only","input":"请朗读原文","voice":"vivian","response_format":%q,"speed":1.25,"language":"Chinese","task_type":"CustomVoice","max_new_tokens":128,"seed":7,"extra_params":{"temperature":0.7}}`, format))
+			engine := NewBuiltinEngine()
+			result, err := engine.TranslateRequest(llmprotocol.OpenAISpeechV1, llmprotocol.OpenAISpeechV1, body, func(r *llmprotocol.Request) error {
+				r.Model = "provider/qwen-tts"
+				r.Generation++
+				return nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			var expected, actual map[string]any
+			if err := json.Unmarshal(body, &expected); err != nil {
+				t.Fatal(err)
+			}
+			if err := json.Unmarshal(result.Body, &actual); err != nil {
+				t.Fatal(err)
+			}
+			expected["model"] = "provider/qwen-tts"
+			e, _ := json.Marshal(expected)
+			a, _ := json.Marshal(actual)
+			if !bytes.Equal(e, a) {
+				t.Fatalf("parameters changed: expected %s, got %s", e, a)
+			}
+			if !llmprotocol.RequiredCapabilities(result.Request).Supports(llmprotocol.CapabilitySpeechGeneration) {
+				t.Fatal("missing speech capability")
+			}
+			if _, err := engine.EncodeRequest(llmprotocol.OpenAIChatV1, result.Request, result.Envelope); err == nil {
+				t.Fatal("TTS must not become Chat")
+			}
+		})
+	}
+}
+
+func TestSpeechCodecRejectsInvalidOrLossyInput(t *testing.T) {
+	for _, body := range []string{
+		`{"model":"auto","input":"hi","unknown":1}`,
+		`{"model":"auto","input":"hi","INPUT":"other"}`,
+		`{"model":"auto","input":"hi","speed":0}`,
+		`{"model":"auto","input":"hi","response_format":"aac"}`,
+		`{"model":"auto","input":"hi","response_format":"mp3","stream":true}`,
+		`{"model":"auto","input":"hi","stream_format":"invalid"}`,
+		`{"model":"auto","input":"hi","max_new_tokens":0}`,
+		`{"model":"auto","input":""}`,
+		`{"model":"auto","input":"hi"} {}`,
+	} {
+		if _, _, _, err := NewBuiltinEngine().DecodeRequest(llmprotocol.OpenAISpeechV1, []byte(body)); err == nil {
+			t.Fatalf("accepted invalid request: %s", body)
+		}
+	}
+}
+
+func TestSpeechCodecBinaryResponseRoundTrip(t *testing.T) {
+	// Includes NUL and invalid UTF-8; no JSON or text treatment is permitted.
+	body := []byte{'R', 'I', 'F', 'F', 0, 255, 128, 1}
+	result, err := NewBuiltinEngine().TranslateResponse(llmprotocol.OpenAISpeechV1, llmprotocol.OpenAISpeechV1, body, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(body, result.Body) {
+		t.Fatalf("audio changed: %x", result.Body)
+	}
+}
+
+func TestSpeechCodecStreamingIsSameWireAndRequiresStreamingCapability(t *testing.T) {
+	r, _, _, err := NewBuiltinEngine().DecodeRequest(llmprotocol.OpenAISpeechV1,
+		[]byte(`{"model":"auto","input":"hi","response_format":"pcm","stream_format":"audio"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !r.Stream || !llmprotocol.RequiredCapabilities(r).Supports(llmprotocol.CapabilityStreaming) {
+		t.Fatal("streaming requirement lost")
+	}
+	if _, _, err := (SpeechCodec{}).NewDecoder(llmprotocol.StreamContext{}, llmprotocol.DefaultPolicy()).Push([]byte("data: {}")); err == nil {
+		t.Fatal("speech SSE must not be decoded as Chat events")
+	}
+}
