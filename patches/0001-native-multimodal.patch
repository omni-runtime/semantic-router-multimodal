+func TestNativeMultipartDispatchRetainsBoundaryAndTask(t *testing.T) {
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	writer.WriteField("model", "auto")
+	writer.WriteField("max_completion_tokens", "32")
+	part, err := writer.CreateFormFile("file", "speech.wav")
+	if err != nil {
+		t.Fatal(err)
+	}
+	part.Write([]byte{0, 255, 1, 13, 10})
+	writer.Close()
+	r, model := routingTestRouterForFormat(llmprotocol.OpenAIChatV1)
+	ctx := &RequestContext{Headers: map[string]string{"content-type": writer.FormDataContentType(), ":path": "/v1/audio/transcriptions"}, SourceFormat: llmprotocol.OpenAITranscriptionV1}
+	request, rejected := r.prepareProtocolRequest(body.Bytes(), ctx)
+	if rejected != nil {
+		t.Fatal("multipart ingress rejected")
+	}
+	if _, err := r.prepareProviderDispatch(request, model, "", false, ctx); err == nil {
+		t.Fatal("chat backend accepted ASR task")
+	}
+	params := r.Config.ModelConfig[model]
+	params.APIFormat = config.APIFormatTranscription
+	params.Capabilities = []string{"text", "audio_input", "transcription"}
+	r.Config.ModelConfig[model] = params
+	dispatch, err := r.prepareProviderDispatch(request, model, "", false, ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if requestWirePath(dispatch.targetFormat) != "/v1/audio/transcriptions" {
+		t.Fatal("ASR was routed to a Chat path")
+	}
+	encoded, err := r.encodeDispatchRequest(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(encoded, []byte{0, 255, 1, 13, 10}) || !strings.Contains(protocolcodec.MultipartRequestContentType(ctx.ProtocolEnvelope), ctx.ProtocolEnvelope.MultipartBoundary) {
+		t.Fatal("file or boundary lost")
+	}
+	if !isNativeMediaPassthrough(ctx) {
+		t.Fatal("ASR response would be decoded as chat")
+	}
+}
