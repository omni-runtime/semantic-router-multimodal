--- /dev/null
+++ b/src/semantic-router/pkg/config/canonical_media_bindings_test.go
@@ -0,0 +1,45 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCanonicalMediaBindingsRoundtripAndValidation(t *testing.T) {
+	document := `
+version: v0.3
+providers:
+  models:
+    - name: video-instance-1
+      api_format: video
+      provider_model_id: native-video
+      backend_refs:
+        - name: primary
+          provider: vllm-omni
+          base_url: http://video-one:8000/v1
+routing: {}
+global:
+  stores:
+    media_bindings:
+      address: redis:6379
+      password_env: MEDIA_REDIS_PASSWORD
+      database: 2
+      tls: true
+      ttl_seconds: 3600
+      max_total_bytes: 1048576
+      instances: {video-instance-1: instance-generation-1}
+`
+	cfg, err := ParseYAMLBytes([]byte(document))
+	if err != nil {
+		t.Fatal(err)
+	}
+	exported := CanonicalConfigFromRouterConfig(cfg).Global.Stores.MediaBindings
+	if exported == nil || exported.PasswordEnv != "MEDIA_REDIS_PASSWORD" || exported.TTLSeconds != 3600 || exported.Instances["video-instance-1"] != "instance-generation-1" {
+		t.Fatalf("lost binding configuration: %+v", exported)
+	}
+	for _, change := range [][2]string{{"ttl_seconds: 3600", "ttl_seconds: 0"}, {"max_total_bytes: 1048576", "max_total_bytes: 2"}, {"redis:6379", "redis"}, {"instance-generation-1", "''"}, {"api_format: video", "api_format: video_sync"}} {
+		if _, err := ParseYAMLBytes([]byte(strings.Replace(document, change[0], change[1], 1))); err == nil {
+			t.Fatalf("invalid media binding config accepted: %v", change)
+		}
+	}
+}
