diff --git a/src/semantic-router/pkg/llmprotocol/mlx_video.go b/src/semantic-router/pkg/llmprotocol/mlx_video.go
new file mode 100644
index 000000000..6e963da13
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/mlx_video.go
@@ -0,0 +1,78 @@
+package llmprotocol
+
+import (
+	"encoding/base64"
+	"strings"
+)
+
+// MLXVideoOptions preserves the native MLX-Serve H3 FL2VA request. The response
+// contains RGB frames and PCM audio, not a video job or an MP4 container.
+type MLXVideoOptions struct {
+	Prompt          string  `json:"prompt"`
+	Width           *int64  `json:"width,omitempty"`
+	Height          *int64  `json:"height,omitempty"`
+	NumFrames       *int64  `json:"num_frames,omitempty"`
+	Steps           *int64  `json:"steps,omitempty"`
+	Seed            *uint64 `json:"seed,omitempty"`
+	Turbo           bool    `json:"turbo,omitempty"`
+	Fast            *bool   `json:"fast,omitempty"`
+	ChainWindows    *int64  `json:"chain_windows,omitempty"`
+	FirstFrameImage string  `json:"first_frame_image,omitempty"`
+	LastFrameImage  string  `json:"last_frame_image,omitempty"`
+	Preview         bool    `json:"preview,omitempty"`
+	PreviewFrames   *int64  `json:"preview_frames,omitempty"`
+	PreviewMaxSide  *int64  `json:"preview_max_side,omitempty"`
+}
+
+func ValidateMLXVideo(request Request) error {
+	v := request.MLXVideo
+	if v == nil {
+		return nil
+	}
+	invalid := func(s string) error { return NewError(ErrorInvalidRequest, "invalid_mlx_video", s, nil) }
+	if strings.TrimSpace(v.Prompt) == "" {
+		return invalid("video prompt is required")
+	}
+	if request.Multipart != nil || request.ChatOutput != nil || request.SpeechGeneration != nil || request.AudioGeneration != nil || request.ImageGeneration != nil || request.Realtime != nil || len(request.Tools) != 0 || len(request.Instructions) != 0 || len(request.Messages) != 1 || request.Messages[0].Role != RoleUser || len(request.Messages[0].Content) != 1 || request.Messages[0].Content[0].Kind != ContentText || request.Messages[0].Content[0].Text != v.Prompt {
+		return invalid("video requires one native prompt without other tasks or instructions")
+	}
+	if request.Sampling.MaxOutputTokens != nil || request.Sampling.AutomaticOutput {
+		return invalid("video does not use a text output token budget")
+	}
+	for _, n := range []*int64{v.Width, v.Height} {
+		if n != nil && (*n < 32 || *n > 2048 || *n%32 != 0) {
+			return invalid("video dimensions must be multiples of 32 between 32 and 2048")
+		}
+	}
+	if v.NumFrames != nil && (*v.NumFrames < 1 || *v.NumFrames > 1024) {
+		return invalid("num_frames must be between 1 and 1024")
+	}
+	if v.Steps != nil && (*v.Steps < 1 || *v.Steps > 1000 || v.Turbo && *v.Steps < 4) {
+		return invalid("steps must be 1-1000; turbo requires at least 4")
+	}
+	if v.ChainWindows != nil && (*v.ChainWindows < 1 || *v.ChainWindows > 6) {
+		return invalid("chain_windows must be 1-6")
+	}
+	if v.Preview && !request.Stream {
+		return invalid("preview requires streaming")
+	}
+	if v.PreviewFrames != nil && (*v.PreviewFrames < 1 || *v.PreviewFrames > 16) {
+		return invalid("preview_frames must be 1-16")
+	}
+	if v.PreviewMaxSide != nil && (*v.PreviewMaxSide < 32 || *v.PreviewMaxSide > 1024) {
+		return invalid("preview_max_side must be 32-1024")
+	}
+	for _, frame := range []string{v.FirstFrameImage, v.LastFrameImage} {
+		if frame == "" {
+			continue
+		}
+		data, err := base64.StdEncoding.Strict().DecodeString(frame)
+		if err != nil || len(data) < 8 || len(data) > 8*1024*1024 {
+			return invalid("keyframes require base64 PNG/JPEG up to 8 MiB")
+		}
+		if string(data[:8]) != "\x89PNG\r\n\x1a\n" && !(data[0] == 0xff && data[1] == 0xd8 && data[2] == 0xff) {
+			return invalid("keyframes require PNG/JPEG")
+		}
+	}
+	return nil
+}
diff --git a/src/semantic-router/pkg/llmprotocol/multipart_task.go b/src/semantic-router/pkg/llmprotocol/multipart_task.go
new file mode 100644
index 000000000..f6ad6bf40
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/multipart_task.go
@@ -0,0 +1,82 @@
+package llmprotocol
+
+import (
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+type MultipartTask string
+
+const (
+	TaskTranscription MultipartTask = "transcription"
+	TaskTranslation   MultipartTask = "translation"
+	TaskImageEdit     MultipartTask = "image_edit"
+	TaskVideoSync     MultipartTask = "video_sync"
+	TaskVideoCreate   MultipartTask = "video_create"
+)
+
+// MultipartOperation owns native form semantics. File content lives once in
+// Messages, referenced by index; names are metadata and never filesystem paths.
+type MultipartOperation struct {
+	Task   MultipartTask
+	Fields []MediaFormField
+	Files  []MediaFormFile
+}
+type MediaFormField struct{ Name, Value string }
+type MediaFormFile struct {
+	Name, Filename, ContentType string
+	ContentIndex                int
+}
+
+func ValidateMultipartOperation(request Request) error {
+	op := request.Multipart
+	if op == nil {
+		return nil
+	}
+	invalid := func(message string) error {
+		return NewError(ErrorInvalidRequest, "invalid_multipart_task", message, nil)
+	}
+	if request.ImageGeneration != nil || request.SpeechGeneration != nil || request.AudioGeneration != nil || len(request.Tools) != 0 || len(request.Instructions) != 0 || len(request.Messages) != 1 || request.Messages[0].Role != RoleUser {
+		return invalid("multipart media requires one native task without chat tools or instructions")
+	}
+	if (op.Task == TaskImageEdit || (op.Task == TaskVideoSync || op.Task == TaskVideoCreate)) && request.Sampling.MaxOutputTokens != nil {
+		return invalid("image edits do not use a text output budget")
+	}
+	var expectedText, actualText []string
+	expectedStream := false
+	for _, field := range op.Fields {
+		if field.Name == "prompt" && field.Value != "" {
+			expectedText = append(expectedText, field.Value)
+		}
+		if field.Name == "stream" {
+			expectedStream, _ = strconv.ParseBool(field.Value)
+		}
+	}
+	for _, content := range request.Messages[0].Content {
+		if content.Kind == ContentText {
+			actualText = append(actualText, content.Text)
+		}
+	}
+	if strings.Join(expectedText, "\n") != strings.Join(actualText, "\n") || expectedStream != request.Stream {
+		return invalid("multipart prompt and stream semantics must match native form fields")
+	}
+	sampling := request.Sampling
+	sampling.MaxOutputTokens = nil
+	if !reflect.DeepEqual(sampling, Sampling{}) {
+		return invalid("multipart sampling controls must be expressed in its native form fields")
+	}
+	if op.Task != TaskTranscription && op.Task != TaskTranslation && op.Task != TaskImageEdit && op.Task != TaskVideoSync && op.Task != TaskVideoCreate {
+		return invalid("unknown multipart task")
+	}
+	for _, file := range op.Files {
+		if file.ContentIndex < 0 || file.ContentIndex >= len(request.Messages[0].Content) {
+			return invalid("multipart file content is unavailable")
+		}
+		c := request.Messages[0].Content[file.ContentIndex]
+		if c.Data == "" || (op.Task == TaskImageEdit && c.Kind != ContentImage) || (op.Task != TaskImageEdit && op.Task != TaskVideoSync && op.Task != TaskVideoCreate && c.Kind != ContentAudio) || ((op.Task == TaskVideoSync || op.Task == TaskVideoCreate) && c.Kind != ContentImage && c.Kind != ContentAudio && c.Kind != ContentVideo) {
+			return invalid("multipart file has incompatible task content")
+		}
+	}
+	return nil
+}
diff --git a/src/semantic-router/pkg/llmprotocol/native_image_generation.go b/src/semantic-router/pkg/llmprotocol/native_image_generation.go
new file mode 100644
index 000000000..cf08d4fe6
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/native_image_generation.go
@@ -0,0 +1,61 @@
+package llmprotocol
+
+import (
+	"encoding/json"
+	"math"
+	"strconv"
+	"strings"
+)
+
+func ValidateNativeImageGeneration(options *ImageGenerationOptions) error {
+	if options == nil || options.Native == nil {
+		return nil
+	}
+	n := options.Native
+	invalid := func(message string) error {
+		return NewError(ErrorInvalidRequest, "invalid_image_request", message, nil)
+	}
+	switch n.ResponseFormat {
+	case "", "b64_json", "url", "file":
+	default:
+		return invalid("unsupported image response_format")
+	}
+	if options.Size != "" && options.Size != "auto" {
+		parts := strings.Split(options.Size, "x")
+		if len(parts) != 2 {
+			return invalid("size must be WIDTHxHEIGHT or auto")
+		}
+		for _, part := range parts {
+			value, err := strconv.ParseInt(part, 10, 64)
+			if err != nil || value <= 0 {
+				return invalid("image dimensions must be positive integers")
+			}
+		}
+	}
+	if n.Layers != nil && (*n.Layers < 2 || *n.Layers > 10) {
+		return invalid("layers must be between 2 and 10")
+	}
+	if n.NumInferenceSteps != nil && (*n.NumInferenceSteps < 1 || *n.NumInferenceSteps > 200) {
+		return invalid("num_inference_steps must be between 1 and 200")
+	}
+	for _, scale := range []*float64{n.GuidanceScale, n.TrueCFGScale} {
+		if scale != nil && (math.IsNaN(*scale) || math.IsInf(*scale, 0) || *scale < 0 || *scale > 20) {
+			return invalid("image guidance scales must be between 0 and 20")
+		}
+	}
+	if n.FlowShift != nil && (math.IsNaN(*n.FlowShift) || math.IsInf(*n.FlowShift, 0)) {
+		return invalid("flow_shift must be finite")
+	}
+	switch n.UseSystemPrompt {
+	case "", "dynamic", "en_vanilla", "en_recaption", "en_think_recaption", "en_unified", "custom":
+	default:
+		return invalid("unsupported use_system_prompt")
+	}
+	for _, object := range []map[string]json.RawMessage{n.ExtraParams, n.LoRA} {
+		encoded, err := json.Marshal(object)
+		if err != nil || len(encoded) > DefaultPolicy().Limits.MetadataBytes {
+			return invalid("native image extension exceeds its metadata limit")
+		}
+	}
+	return nil
+}
