diff --git a/src/semantic-router/pkg/llmprotocol/realtime.go b/src/semantic-router/pkg/llmprotocol/realtime.go
new file mode 100644
index 000000000..93cfb6586
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/realtime.go
@@ -0,0 +1,40 @@
+package llmprotocol
+
+import "reflect"
+
+const (
+	VLLMRealtimeV1     WireFormat = "vllm.realtime.v1"
+	OmniSpeechStreamV1 WireFormat = "omni.speech-stream.v1"
+)
+
+// RealtimeSession is the typed handshake contract. It declares selection
+// requirements, not a prompt, inference result, or individual WebSocket frame.
+// The selected engine owns native frame validation and per-turn limits.
+type RealtimeSession struct {
+	Format      WireFormat
+	AudioOutput bool
+}
+
+func ValidateRealtime(request Request) error {
+	if request.Realtime == nil {
+		return nil
+	}
+	if request.Realtime.Format != VLLMRealtimeV1 && request.Realtime.Format != OmniSpeechStreamV1 {
+		return NewError(ErrorInvalidRequest, "invalid_realtime_protocol", "unsupported realtime session protocol", nil)
+	}
+	if request.Realtime.Format == OmniSpeechStreamV1 && !request.Realtime.AudioOutput {
+		return NewError(ErrorInvalidRequest, "invalid_realtime_output", "speech sessions require audio output", nil)
+	}
+	// Fail closed on semantic plugins that would otherwise silently inject a
+	// prompt, cache policy, or token budget into a bodyless handshake.
+	remaining := request
+	remaining.Generation = 0
+	remaining.Model = ""
+	remaining.Trusted = TrustedMetadata{}
+	remaining.Realtime = nil
+	remaining.Stream = false
+	if !request.Stream || !reflect.DeepEqual(remaining, Request{}) {
+		return NewError(ErrorUnsupportedFeature, "realtime_handshake_only", "realtime routing accepts session requirements only; inference content and limits belong to native frames", nil)
+	}
+	return nil
+}
