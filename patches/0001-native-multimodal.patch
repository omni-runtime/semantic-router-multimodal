+func TestSpeechDispatchRejectsChatBeforeSingleCandidateSelection(t *testing.T) {
+	r, model := routingTestRouterForFormat(llmprotocol.OpenAIChatV1)
+	p := r.Config.ModelConfig[model]
+	p.APIFormat = config.APIFormatSpeech
+	p.Capabilities = []string{"text", "speech_generation"}
+	r.Config.ModelConfig[model] = p
+	request := testNeutralRequest("auto", "Generate an answer")
+	ctx := routingTestContext(llmprotocol.OpenAIChatV1, request)
+	if _, err := r.prepareProviderDispatch(request, model, "", false, ctx); err == nil {
+		t.Fatal("speech sink accepted a chat-generation task")
+	}
+	_, err := r.eligibleRequestModelRefs(&config.CandidateRequirements{Capabilities: config.CandidateCapabilitiesDeclared},
+		[]config.ModelRef{{Model: model}}, request, nil)
+	if !errors.Is(err, selection.ErrNoEligibleCandidates) {
+		t.Fatalf("single speech candidate was not excluded before selection: %v", err)
+	}
+}
