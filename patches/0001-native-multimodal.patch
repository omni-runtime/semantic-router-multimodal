+func TestNativeRealtimeRejectsInvalidUpgradeBeforeSelection(t *testing.T) {
+	r := &OpenAIRouter{}
+	for _, bad := range []string{"upgrade", "connection", "sec-websocket-version", "sec-websocket-key"} {
+		ctx := routingTestContext(llmprotocol.VLLMRealtimeV1, nil)
+		ctx.Headers = map[string]string{"upgrade": "websocket", "connection": "Upgrade", "sec-websocket-version": "13", "sec-websocket-key": "dGhlIHNhbXBsZSBub25jZQ=="}
+		delete(ctx.Headers, bad)
+		resp, err := r.handleRealtimeRequestHeaders("GET", "/v1/realtime?model=auto&sr_input=audio&sr_output=text", ctx)
+		if err != nil || resp.GetImmediateResponse().GetStatus().GetCode() != 400 {
+			t.Fatalf("invalid upgrade accepted: %v %v", resp, err)
+		}
+	}
+}
