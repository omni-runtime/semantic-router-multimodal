+func TestNativeImagesCodecRetainsGenerationControls(t *testing.T) {
+	body := []byte(`{"model":"auto","prompt":"a blue square","n":2,"size":"512x768","response_format":"file","user":"client-1","quality":"hd","output_format":"png","output_compression":90,"negative_prompt":"text","num_inference_steps":4,"guidance_scale":2.5,"true_cfg_scale":3,"flow_shift":1,"seed":7,"layers":3,"bot_task":"cot","system_prompt":"style","use_system_prompt":"custom","generator_device":"cpu","lora":{"name":"style","scale":0.5},"extra_params":{"custom":true},"vae_use_slicing":true,"vae_use_tiling":false,"return_stage_metrics":true}`)
+	engine := NewBuiltinEngine()
+	result, err := engine.TranslateRequest(llmprotocol.OpenAIImagesV1, llmprotocol.OpenAIImagesV1, body, func(r *llmprotocol.Request) error {
+		r.Model = "native-image-model"
+		r.Generation++
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want, got map[string]any
+	if err := json.Unmarshal(body, &want); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal(result.Body, &got); err != nil {
+		t.Fatal(err)
+	}
+	want["model"] = "native-image-model"
+	if !reflect.DeepEqual(want, got) {
+		t.Fatalf("image parameters changed: want %v, got %v", want, got)
+	}
+	required := llmprotocol.RequiredCapabilities(result.Request)
+	if !required.Supports(llmprotocol.CapabilityImageGeneration) || required.Supports(llmprotocol.CapabilityTools) {
+		t.Fatal("a native operation must require image generation without becoming a hosted function tool")
+	}
+	if _, err := engine.EncodeRequest(llmprotocol.OpenAIResponsesV1, result.Request, result.Envelope); err == nil {
+		t.Fatal("unsupported diffusion controls must not be lost in cross-protocol translation")
+	}
+}
+
+func TestNativeImagesCodecStrictIngressAndDefaults(t *testing.T) {
+	engine := NewBuiltinEngine()
+	for _, body := range []string{
+		`{"model":"auto","prompt":"x","prompt":"y"}`,
+		`{"model":"auto","prompt":"x","unknown":1}`,
+		`{"model":"auto","prompt":"x","n":0}`,
+		`{"model":"auto","prompt":"x","size":"0x512"}`,
+		`{"model":"auto","prompt":"x","num_inference_steps":201}`,
+		`{"model":"auto","prompt":"x","guidance_scale":-1}`,
+		`{"model":"auto","prompt":"x","response_format":"video"}`,
+	} {
+		if _, _, _, err := engine.DecodeRequest(llmprotocol.OpenAIImagesV1, []byte(body)); err == nil {
+			t.Fatalf("invalid image request accepted: %s", body)
