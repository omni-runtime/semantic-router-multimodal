index 000000000..ba9c2b67f
--- /dev/null
+++ b/src/semantic-router/pkg/llmprotocol/chat_output.go
@@ -0,0 +1,61 @@
+package llmprotocol
+
+import "strings"
+
+// ChatOutputOptions is a single model's native mixed output contract. It does
+// not request a second model invocation, TTS task or client-side workflow.
+type ChatOutputOptions struct {
+	Modalities []string
+	Audio      *ChatAudioOptions
+}
+type ChatAudioOptions struct {
+	Format string `json:"format,omitempty"`
+	Voice  string `json:"voice,omitempty"`
+}
+
+func (o *ChatOutputOptions) HasAudio() bool {
+	if o != nil {
+		for _, modality := range o.Modalities {
+			if modality == "audio" {
+				return true
+			}
+		}
+	}
+	return false
+}
+func ValidateChatOutput(request Request) error {
+	o := request.ChatOutput
+	if o == nil {
+		return nil
+	}
+	invalid := func(message string) error { return NewError(ErrorInvalidRequest, "invalid_chat_output", message, nil) }
+	if request.Multipart != nil || request.SpeechGeneration != nil || request.AudioGeneration != nil || request.ImageGeneration != nil {
+		return invalid("Chat output modalities cannot be combined with a separate native media task")
+	}
+	if len(o.Modalities) < 1 || len(o.Modalities) > 2 {
+		return invalid("modalities must contain text, audio, or both")
+	}
+	seen := map[string]bool{}
+	for _, m := range o.Modalities {
+		if (m != "text" && m != "audio") || seen[m] {
+			return invalid("unsupported or duplicate Chat output modality")
+		}
+		seen[m] = true
+	}
+	if o.Audio != nil {
+		if !o.HasAudio() {
+			return invalid("audio options require audio in modalities")
+		}
+		switch o.Audio.Format {
+		case "", "wav", "mp3", "flac", "aac", "opus", "pcm16":
+		default:
+			return invalid("unsupported Chat audio output format")
+		}
+		if len(o.Audio.Voice) > 256 || strings.ContainsAny(o.Audio.Voice, "\r\n\x00") {
+			return invalid("audio voice is invalid or too long")
+		}
+	}
+	// A provider such as vLLM-Omni can supply audio defaults. No voice, format or
+	// output modality is invented by the codec when the caller omits it.
+	return nil
+}
