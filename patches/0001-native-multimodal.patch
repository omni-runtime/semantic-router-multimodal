+++ b/src/semantic-router/pkg/protocolcodec/mlx_video_codec_test.go
@@ -0,0 +1,55 @@
+package protocolcodec
+
+import (
+	"encoding/json"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"testing"
+)
+
+func TestMLXVideoRoundTripAndTaskIsolation(t *testing.T) {
+	e := NewBuiltinEngine()
+	input := []byte(`{"model":"auto","prompt":"a cat walking","stream":true,"width":256,"height":256,"num_frames":22,"steps":4,"seed":7,"turbo":true,"fast":false,"chain_windows":1}`)
+	r, env, _, err := e.DecodeRequestForMutation(llmprotocol.MLXVideoV1, input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	output, _, err := (MLXVideoCodec{}).EncodeRequest(r, env, llmprotocol.DefaultPolicy())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var want, got any
+	json.Unmarshal(input, &want)
+	json.Unmarshal(output, &got)
+	a, _ := json.Marshal(want)
+	b, _ := json.Marshal(got)
+	if string(a) != string(b) {
+		t.Fatalf("fields lost: %s", output)
+	}
+	for _, f := range []llmprotocol.WireFormat{llmprotocol.OpenAIChatV1, llmprotocol.OmniVideoSyncV1, llmprotocol.OmniVideoV1, llmprotocol.OpenAISpeechV1} {
+		if err := ValidateMediaTask(r, f); err == nil {
+			t.Fatalf("accepted incompatible target %s", f)
+		}
+	}
+	if err := ValidateMediaTask(llmprotocol.Request{}, llmprotocol.MLXVideoV1); err == nil {
+		t.Fatal("accepted non-video task")
+	}
+}
+
+func TestMLXVideoRejectsUnsupportedAndInvalidFields(t *testing.T) {
+	for _, body := range []string{
+		`{"model":"auto","prompt":""}`,
+		`{"model":"auto","prompt":"x","width":255}`,
+		`{"model":"auto","prompt":"x","turbo":true,"steps":3}`,
+		`{"model":"auto","prompt":"x","chain_windows":7}`,
+		`{"model":"auto","prompt":"x","preview":true}`,
+		`{"model":"auto","prompt":"x","first_frame_image":"https://example.com/x.png"}`,
+		`{"model":"auto","prompt":"x","ref_images":[]}`,
+		`{"model":"auto","prompt":"x","lora_paths":["/tmp/x"]}`,
+		`{"model":"auto","prompt":"x","max_tokens":32}`,
+		`{"model":"auto","prompt":"x","Prompt":"shadow"}`,
+	} {
+		if _, _, _, err := NewBuiltinEngine().DecodeRequestForMutation(llmprotocol.MLXVideoV1, []byte(body)); err == nil {
+			t.Fatalf("accepted %s", body)
+		}
+	}
+}
diff --git a/src/semantic-router/pkg/protocolcodec/multipart_codec.go b/src/semantic-router/pkg/protocolcodec/multipart_codec.go
new file mode 100644
index 000000000..332ac6f4d
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/multipart_codec.go
@@ -0,0 +1,309 @@
+package protocolcodec
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/textproto"
+	"reflect"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+// HTTPRequestCodec is the optional codec boundary for bodies whose grammar
+// depends on HTTP metadata. It does not participate in model selection.
+type HTTPRequestCodec interface {
+	DecodeHTTPRequest([]byte, string, llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error)
+}
+
+type MultipartCodec struct {
+	SpeechCodec
+	Task llmprotocol.MultipartTask
+}
+
+func (c MultipartCodec) Format() llmprotocol.WireFormat {
+	switch c.Task {
+	case llmprotocol.TaskVideoCreate:
+		return llmprotocol.OmniVideoV1
+	case llmprotocol.TaskVideoSync:
+		return llmprotocol.OmniVideoSyncV1
+	case llmprotocol.TaskTranscription:
+		return llmprotocol.OpenAITranscriptionV1
+	case llmprotocol.TaskTranslation:
+		return llmprotocol.OpenAITranslationV1
+	default:
+		return llmprotocol.OpenAIImageEditV1
+	}
+}
+func (c MultipartCodec) Capabilities() llmprotocol.CapabilitySet {
+	if c.Task == llmprotocol.TaskVideoSync || c.Task == llmprotocol.TaskVideoCreate {
+		return llmprotocol.Capabilities(llmprotocol.CapabilityText, llmprotocol.CapabilityImageInput, llmprotocol.CapabilityAudioInput, llmprotocol.CapabilityVideoInput, llmprotocol.CapabilityVideoOutput, llmprotocol.CapabilityAudioOutput, llmprotocol.CapabilityVideoGeneration, llmprotocol.CapabilityMultipart)
+	}
+	if c.Task == llmprotocol.TaskImageEdit {
+		return llmprotocol.Capabilities(llmprotocol.CapabilityText, llmprotocol.CapabilityImageInput, llmprotocol.CapabilityImageEditing, llmprotocol.CapabilityMultipart, llmprotocol.CapabilityStreaming)
+	}
+	task := llmprotocol.CapabilityTranscription
+	if c.Task == llmprotocol.TaskTranslation {
+		task = llmprotocol.CapabilityTranslation
+	}
+	return llmprotocol.Capabilities(llmprotocol.CapabilityText, llmprotocol.CapabilityAudioInput, task, llmprotocol.CapabilityMultipart, llmprotocol.CapabilityStreaming)
+}
+func (c MultipartCodec) DecodeRequest(_ []byte, _ llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, multipartError("multipart decoding requires the HTTP Content-Type boundary")
+}
+func multipartError(message string) error {
+	return llmprotocol.NewError(llmprotocol.ErrorInvalidRequest, "invalid_multipart", message, nil)
+}
+
+func (c MultipartCodec) DecodeHTTPRequest(body []byte, contentType string, policy llmprotocol.Policy) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	fail := func(err error) (llmprotocol.Request, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+		return llmprotocol.Request{}, llmprotocol.Envelope{}, nil, err
+	}
+	media, params, err := mime.ParseMediaType(contentType)
+	if err != nil || media != "multipart/form-data" || params["boundary"] == "" {
+		return fail(multipartError("multipart/form-data with a boundary is required"))
+	}
+	if len(body) == 0 || len(body) > 16<<20 || len(body) > policy.Limits.BodyBytes {
+		return fail(multipartError("multipart body exceeds 16 MiB upload limit"))
+	}
+	validator := multipart.NewWriter(io.Discard)
+	if err := validator.SetBoundary(params["boundary"]); err != nil {
+		return fail(multipartError("invalid MIME boundary"))
+	}
+	request := llmprotocol.Request{Generation: 1, Multipart: &llmprotocol.MultipartOperation{Task: c.Task}, Messages: []llmprotocol.Message{{Role: llmprotocol.RoleUser}}}
+	counts := map[string]int{}
+	reader := multipart.NewReader(bytes.NewReader(body), params["boundary"])
+	parts := 0
+	for {
+		part, err := reader.NextRawPart()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			return fail(multipartError("malformed multipart body"))
+		}
+		parts++
+		if parts > 64 {
+			return fail(multipartError("multipart contains more than 64 parts"))
+		}
+		disposition, attrs, err := mime.ParseMediaType(part.Header.Get("Content-Disposition"))
+		if err != nil || disposition != "form-data" || attrs["name"] == "" || len(attrs["name"]) > 128 {
+			return fail(multipartError("invalid form Content-Disposition"))
+		}
+		for key := range part.Header {
+			if key != "Content-Disposition" && key != "Content-Type" {
+				return fail(multipartError("unsupported multipart part header"))
+			}
+		}
+		name := attrs["name"]
+		data, err := io.ReadAll(io.LimitReader(part, 16<<20+1))
+		if err != nil || len(data) > 16<<20 {
+			return fail(multipartError("invalid or oversized form part"))
+		}
+		counts[name]++
+		if filename, isFile := attrs["filename"]; isFile {
+			if !multipartFileAllowed(c.Task, name) || filename == "" || len(filename) > 1024 || len(data) == 0 || len(request.Multipart.Files) >= 16 {
+				return fail(multipartError("unexpected, empty or excessive media file"))
+			}
+			if c.Task != llmprotocol.TaskImageEdit && name != "input_references" && counts[name] > 1 {
+				return fail(multipartError("audio tasks require exactly one file"))
+			}
+			contentType := part.Header.Get("Content-Type")
+			if contentType == "" {
+				contentType = "application/octet-stream"
+			}
+			if _, _, err := mime.ParseMediaType(contentType); err != nil {
+				return fail(multipartError("invalid media part Content-Type"))
+			}
+			kind := llmprotocol.ContentAudio
+			if c.Task == llmprotocol.TaskImageEdit {
+				kind = llmprotocol.ContentImage
+			}
+			if c.Task == llmprotocol.TaskVideoSync || c.Task == llmprotocol.TaskVideoCreate {
+				switch {
+				case strings.HasPrefix(contentType, "image/"):
+					kind = llmprotocol.ContentImage
+				case strings.HasPrefix(contentType, "video/"):
+					kind = llmprotocol.ContentVideo
+				case strings.HasPrefix(contentType, "audio/"):
+					kind = llmprotocol.ContentAudio
+				default:
+					return fail(multipartError("video reference upload requires image, video or audio MIME type"))
+				}
+			}
+			index := len(request.Messages[0].Content)
+			request.Messages[0].Content = append(request.Messages[0].Content, llmprotocol.Content{Kind: kind, MediaType: contentType, Data: base64.StdEncoding.EncodeToString(data)})
+			request.Multipart.Files = append(request.Multipart.Files, llmprotocol.MediaFormFile{Name: name, Filename: filename, ContentType: contentType, ContentIndex: index})
+			continue
+		}
+		if len(data) > 64<<10 || !utf8.Valid(data) {
+			return fail(multipartError("form text must be bounded UTF-8"))
+		}
+		value := string(data)
+		if counts[name] > 1 && name != "timestamp_granularities[]" && name != "url" && name != "url[]" {
+			return fail(multipartError("duplicate single-value form field"))
+		}
+		if err := validateMultipartField(c.Task, name, value); err != nil {
+			return fail(err)
+		}
+		if name == "model" {
+			request.Model = value
+			continue
+		}
+		request.Multipart.Fields = append(request.Multipart.Fields, llmprotocol.MediaFormField{Name: name, Value: value})
+		refs, err := multipartReferenceContents(c.Task, name, value)
+		if err != nil {
+			return fail(err)
+		}
+		request.Messages[0].Content = append(request.Messages[0].Content, refs...)
+		switch name {
+		case "prompt":
+			if value != "" {
+				request.Messages[0].Content = append(request.Messages[0].Content, llmprotocol.Content{Kind: llmprotocol.ContentText, Text: value})
+			}
+		case "stream":
+			request.Stream, _ = strconv.ParseBool(value)
+		case "max_completion_tokens":
+			n, _ := strconv.ParseInt(value, 10, 64)
+			request.Sampling.MaxOutputTokens = &n
+		}
+	}
+	if counts["model"] != 1 || strings.TrimSpace(request.Model) == "" {
+		return fail(multipartError("exactly one public model entrypoint is required"))
+	}
+	if c.Task == llmprotocol.TaskVideoSync || c.Task == llmprotocol.TaskVideoCreate {
+		if counts["prompt"] != 1 {
+			return fail(multipartError("video generation requires a prompt"))
+		}
+	} else if c.Task == llmprotocol.TaskImageEdit {
+		if counts["prompt"] != 1 || counts["image"]+counts["image[]"]+counts["url"]+counts["url[]"] == 0 {
+			return fail(multipartError("image edit requires a prompt and image input"))
+		}
+	} else if counts["file"] != 1 || len(request.Multipart.Files) != 1 {
+		return fail(multipartError("audio task requires one uploaded file"))
+	}
+	if err := llmprotocol.ValidateMultipartOperation(request); err != nil {
+		return fail(err)
+	}
+	envelope := llmprotocol.Envelope{MultipartBoundary: fmt.Sprintf("sr-%x", sha256.Sum256(body))}
+	return request, envelope, nil, nil
+}
+
+func multipartFileAllowed(task llmprotocol.MultipartTask, name string) bool {
+	if task == llmprotocol.TaskVideoSync || task == llmprotocol.TaskVideoCreate {
+		return name == "input_reference" || name == "input_references" || name == "control_reference"
+	}
+	if task != llmprotocol.TaskImageEdit {
+		return name == "file"
+	}
+	switch name {
+	case "image", "image[]", "mask", "mask_image", "reference_image":
+		return true
+	}
+	return false
+}
+
+func (c MultipartCodec) EncodeRequest(request llmprotocol.Request, envelope llmprotocol.Envelope, _ llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	if request.Multipart == nil || request.Multipart.Task != c.Task {
+		return nil, nil, multipartError("endpoint does not match the native multipart task")
+	}
+	if err := llmprotocol.ValidateMultipartOperation(request); err != nil {
+		return nil, nil, err
+	}
+	var expected, actual []llmprotocol.Content
+	for _, field := range request.Multipart.Fields {
+		refs, err := multipartReferenceContents(c.Task, field.Name, field.Value)
+		if err != nil {
+			return nil, nil, err
+		}
+		expected = append(expected, refs...)
+	}
+	files := map[int]bool{}
+	for _, file := range request.Multipart.Files {
+		files[file.ContentIndex] = true
+	}
+	for index, content := range request.Messages[0].Content {
+		if content.Kind != llmprotocol.ContentText && !files[index] {
+			actual = append(actual, content)
+		}
+	}
+	if !reflect.DeepEqual(expected, actual) {
+		return nil, nil, multipartError("native media reference fields differ from semantic input")
+	}
+	var output bytes.Buffer
+	writer := multipart.NewWriter(&output)
+	if envelope.MultipartBoundary != "" {
+		if err := writer.SetBoundary(envelope.MultipartBoundary); err != nil {
+			return nil, nil, err
+		}
+	}
+	if err := writer.WriteField("model", request.Model); err != nil {
+		return nil, nil, err
+	}
+	budgetWritten := false
+	for _, field := range request.Multipart.Fields {
+		value := field.Value
+		if field.Name == "max_completion_tokens" && request.Sampling.MaxOutputTokens != nil {
+			value = strconv.FormatInt(*request.Sampling.MaxOutputTokens, 10)
+			budgetWritten = true
+		}
+		if err := validateMultipartField(c.Task, field.Name, value); err != nil {
+			return nil, nil, err
+		}
+		if err := writer.WriteField(field.Name, value); err != nil {
+			return nil, nil, err
+		}
+	}
+	if !budgetWritten && request.Sampling.MaxOutputTokens != nil {
+		if err := writer.WriteField("max_completion_tokens", strconv.FormatInt(*request.Sampling.MaxOutputTokens, 10)); err != nil {
+			return nil, nil, err
+		}
+	}
+	for _, file := range request.Multipart.Files {
+		data, err := base64.StdEncoding.DecodeString(request.Messages[0].Content[file.ContentIndex].Data)
+		if err != nil {
+			return nil, nil, err
+		}
+		header := textproto.MIMEHeader{}
+		header.Set("Content-Disposition", mime.FormatMediaType("form-data", map[string]string{"name": file.Name, "filename": file.Filename}))
+		header.Set("Content-Type", file.ContentType)
+		part, err := writer.CreatePart(header)
+		if err != nil {
+			return nil, nil, err
+		}
+		if _, err := part.Write(data); err != nil {
+			return nil, nil, err
+		}
+	}
+	if err := writer.Close(); err != nil {
+		return nil, nil, err
+	}
+	return output.Bytes(), nil, nil
+}
+
+// Native multipart responses may be JSON, subtitles, text, images or SSE. The
+// gateway preserves them directly; generic buffered cross-wire conversion is
+// intentionally unavailable instead of inheriting the Speech response codec.
+func (c MultipartCodec) DecodeResponse([]byte, llmprotocol.Policy) (llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Diagnostics, error) {
+	return llmprotocol.Response{}, llmprotocol.Envelope{}, nil, fmt.Errorf("multipart responses require same-wire transport")
+}
+func (c MultipartCodec) EncodeResponse(llmprotocol.Response, llmprotocol.Envelope, llmprotocol.Policy) ([]byte, llmprotocol.Diagnostics, error) {
+	return nil, nil, fmt.Errorf("multipart responses require same-wire transport")
+}
+
+func MultipartRequestContentType(envelope llmprotocol.Envelope) string {
+	return mime.FormatMediaType("multipart/form-data", map[string]string{"boundary": envelope.MultipartBoundary})
+}
+
+func validJSONObject(value string) bool {
+	var object map[string]json.RawMessage
+	return llmprotocol.ValidateJSONObject([]byte(value), llmprotocol.DefaultPolicy().Limits.JSONDepth) == nil && json.Unmarshal([]byte(value), &object) == nil && object != nil
+}
diff --git a/src/semantic-router/pkg/protocolcodec/multipart_codec_test.go b/src/semantic-router/pkg/protocolcodec/multipart_codec_test.go
new file mode 100644
index 000000000..27d2a2204
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/multipart_codec_test.go
@@ -0,0 +1,136 @@
+package protocolcodec
+
+import (
+	"bytes"
+	"encoding/base64"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/textproto"
+	"testing"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func multipartFixture(t *testing.T, fields [][2]string, fileName string) ([]byte, string) {
+	t.Helper()
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	for _, field := range fields {
+		if err := writer.WriteField(field[0], field[1]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	header := textproto.MIMEHeader{}
+	header.Set("Content-Disposition", mime.FormatMediaType("form-data", map[string]string{"name": fileName, "filename": "fixture.bin"}))
+	header.Set("Content-Type", "application/octet-stream")
+	part, err := writer.CreatePart(header)
+	if err != nil {
+		t.Fatal(err)
+	}
+	part.Write([]byte{0, 255, 0, 13, 10, 128})
+	writer.Close()
+	return body.Bytes(), writer.FormDataContentType()
+}
+func TestMultipartTaskRoundTripPreservesFilesAndFormSemantics(t *testing.T) {
+	for _, tc := range []struct {
+		format     llmprotocol.WireFormat
+		file       string
+		capability llmprotocol.Capability
+	}{
+		{llmprotocol.OpenAITranscriptionV1, "file", llmprotocol.CapabilityTranscription},
+		{llmprotocol.OpenAITranslationV1, "file", llmprotocol.CapabilityTranslation},
+		{llmprotocol.OpenAIImageEditV1, "image", llmprotocol.CapabilityImageEditing},
+	} {
+		t.Run(string(tc.format), func(t *testing.T) {
+			fields := [][2]string{{"model", "auto"}, {"prompt", "a quiet scene"}}
+			if tc.file == "file" {
+				fields = append(fields, [2]string{"max_completion_tokens", "32"}, [2]string{"response_format", "text"}, [2]string{"language", "en"})
+			} else {
+				fields = append(fields, [2]string{"response_format", "b64_json"}, [2]string{"seed", "7"})
+			}
+			body, ct := multipartFixture(t, fields, tc.file)
+			engine := NewBuiltinEngine()
+			request, envelope, _, err := engine.DecodeHTTPRequestForMutation(tc.format, body, ct)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !llmprotocol.RequiredCapabilities(request).Supports(tc.capability) {
+				t.Fatal("missing native task capability")
+			}
+			if _, err := engine.EncodeRequest(llmprotocol.OpenAIChatV1, request, envelope); err == nil {
+				t.Fatal("multipart silently converted to chat")
+			}
+			request.Model = "provider-model"
+			request.Generation++
+			encoded, err := engine.EncodeRequest(tc.format, request, envelope)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, params, err := mime.ParseMediaType(MultipartRequestContentType(envelope))
+			if err != nil {
+				t.Fatal(err)
+			}
+			reader := multipart.NewReader(bytes.NewReader(encoded.Body), params["boundary"])
+			values := map[string]string{}
+			var gotFile []byte
+			for {
+				part, err := reader.NextPart()
+				if err == io.EOF {
+					break
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				data, err := io.ReadAll(part)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if part.FileName() != "" {
+					gotFile = data
+					if part.FileName() != "fixture.bin" || part.Header.Get("Content-Type") != "application/octet-stream" {
+						t.Fatal("file metadata lost")
+					}
+				} else {
+					values[part.FormName()] = string(data)
+				}
+			}
+			if !bytes.Equal(gotFile, []byte{0, 255, 0, 13, 10, 128}) || values["model"] != "provider-model" {
+				t.Fatal("file or selected model changed incorrectly")
+			}
+			for _, field := range fields {
+				if field[0] != "model" && values[field[0]] != field[1] {
+					t.Fatalf("form field lost: %v", field)
+				}
+			}
+			file := request.Multipart.Files[0]
+			if got := request.Messages[0].Content[file.ContentIndex].Data; got != base64.StdEncoding.EncodeToString(gotFile) {
+				t.Fatal("media semantic bytes differ")
+			}
+		})
+	}
+}
+func TestMultipartStrictIngress(t *testing.T) {
+	engine := NewBuiltinEngine()
+	for _, fields := range [][][2]string{
+		{{"model", "auto"}, {"model", "cloud-only"}},
+		{{"model", "auto"}, {"unexpected", "ignored"}},
+		{{"model", "auto"}, {"max_completion_tokens", "-1"}},
+		{{"model", "auto"}, {"stream", "perhaps"}},
+		{{"model", "auto"}, {"response_format", "video"}},
+	} {
+		body, ct := multipartFixture(t, fields, "file")
+		if _, _, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OpenAITranscriptionV1, body, ct); err == nil {
+			t.Fatalf("invalid fields accepted: %v", fields)
+		}
+	}
+	body, ct := multipartFixture(t, [][2]string{{"model", "auto"}}, "file")
+	for _, badType := range []string{"application/json", "multipart/form-data", ct + "broken"} {
+		if _, _, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OpenAITranscriptionV1, body, badType); err == nil {
+			t.Fatal("invalid MIME boundary accepted")
+		}
+	}
+	if _, _, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OpenAIImageEditV1, body, ct); err == nil {
+		t.Fatal("audio file accepted as image-edit upload")
+	}
+}
diff --git a/src/semantic-router/pkg/protocolcodec/multipart_fields.go b/src/semantic-router/pkg/protocolcodec/multipart_fields.go
new file mode 100644
index 000000000..3ca6b172c
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/multipart_fields.go
@@ -0,0 +1,152 @@
+package protocolcodec
+
+import (
+	"math"
+	"strconv"
+	"strings"
+
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+)
+
+func validateMultipartField(task llmprotocol.MultipartTask, name, value string) error {
+	if task == llmprotocol.TaskVideoSync || task == llmprotocol.TaskVideoCreate {
+		return validateVideoFormField(name, value)
+	}
+	invalid := func() error { return multipartError("unsupported or invalid form field: " + name) }
+	if name == "model" {
+		if strings.TrimSpace(value) == "" {
+			return invalid()
+		}
+		return nil
+	}
+	if name == "prompt" {
+		if task == llmprotocol.TaskImageEdit && strings.TrimSpace(value) == "" {
+			return invalid()
+		}
+		return nil
+	}
+	if name == "stream" {
+		_, err := strconv.ParseBool(value)
+		if err != nil {
+			return invalid()
+		}
+		return nil
+	}
+	if name == "response_format" {
+		valid := []string{"json", "text", "srt", "verbose_json", "vtt"}
+		if task == llmprotocol.TaskTranscription {
+			valid = append(valid, "diarized_json")
+		}
+		if task == llmprotocol.TaskImageEdit {
+			valid = []string{"b64_json", "url", "file"}
+		}
+		for _, candidate := range valid {
+			if value == candidate {
+				return nil
+			}
+		}
+		return invalid()
+	}
+	if task != llmprotocol.TaskImageEdit {
+		switch name {
+		case "language", "hotwords", "to_language":
+			return nil
+		case "timestamp_granularities[]":
+			if task == llmprotocol.TaskTranscription && (value == "word" || value == "segment") {
+				return nil
+			}
+			return invalid()
+		case "vllm_xargs":
+			if validJSONObject(value) {
+				return nil
+			}
+			return invalid()
+		case "stream_include_usage", "stream_continuous_usage_stats", "use_beam_search", "include_stop_str_in_output":
+			_, err := strconv.ParseBool(value)
+			if err != nil {
+				return invalid()
+			}
+			return nil
+		case "seed":
+			_, err := strconv.ParseInt(value, 10, 64)
+			if err != nil {
+				return invalid()
+			}
+			return nil
+		case "max_completion_tokens", "n":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil || n < 1 {
+				return invalid()
+			}
+			return nil
+		case "top_k":
+			n, err := strconv.ParseInt(value, 10, 64)
+			if err != nil || n < -1 {
+				return invalid()
+			}
+			return nil
+		case "temperature", "top_p", "min_p", "frequency_penalty", "presence_penalty", "repetition_penalty", "length_penalty":
+			n, err := strconv.ParseFloat(value, 64)
+			if err != nil || math.IsNaN(n) || math.IsInf(n, 0) {
+				return invalid()
+			}
+			if (name == "temperature" && (n < 0 || n > 2)) || ((name == "top_p" || name == "min_p") && (n < 0 || n > 1)) || (name == "repetition_penalty" && n <= 0) {
+				return invalid()
+			}
+			return nil
+		}
+		return invalid()
+	}
+	switch name {
+	case "url", "url[]", "negative_prompt", "user", "generator_device", "bot_task", "sys_type", "system_prompt", "mask_image", "reference_image":
+		if strings.TrimSpace(value) == "" {
+			return invalid()
+		}
+		return nil
+	case "size":
+		return llmprotocol.ValidateNativeImageGeneration(&llmprotocol.ImageGenerationOptions{Size: value, Native: &llmprotocol.NativeImageGenerationOptions{}})
+	case "output_format":
+		if value == "png" || value == "jpeg" || value == "webp" {
+			return nil
+		}
+		return invalid()
+	case "background":
+		if value == "auto" || value == "transparent" || value == "opaque" {
+			return nil
+		}
+		return invalid()
+	case "lora":
+		if validJSONObject(value) {
+			return nil
+		}
+		return invalid()
+	case "return_stage_metrics":
+		_, err := strconv.ParseBool(value)
+		if err != nil {
+			return invalid()
+		}
+		return nil
+	case "seed":
+		_, err := strconv.ParseInt(value, 10, 64)
+		if err != nil {
+			return invalid()
+		}
+		return nil
+	case "n", "num_inference_steps", "layers", "resolution", "output_compression":
+		n, err := strconv.ParseInt(value, 10, 64)
+		if err != nil || n < 0 {
+			return invalid()
+		}
+		if (name == "n" && (n < 1 || n > 10)) || (name == "output_compression" && n > 100) || (name == "layers" && (n < 2 || n > 10)) || ((name == "num_inference_steps" || name == "resolution") && n == 0) {
+			return invalid()
+		}
+		return nil
+	case "guidance_scale", "guidance_scale_2", "strength", "true_cfg_scale":
+		n, err := strconv.ParseFloat(value, 64)
+		if err != nil || math.IsNaN(n) || math.IsInf(n, 0) || n < 0 || (name == "strength" && n > 1) {
+			return invalid()
+		}
+		return nil
+	}
+	return invalid()
+}
diff --git a/src/semantic-router/pkg/protocolcodec/multipart_video.go b/src/semantic-router/pkg/protocolcodec/multipart_video.go
new file mode 100644
index 000000000..7d4520fa5
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/multipart_video.go
@@ -0,0 +1,135 @@
+package protocolcodec
+
+import (
+	"encoding/json"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"math"
+	"strconv"
+	"strings"
+)
+
+func validateVideoFormField(name, value string) error {
+	invalid := func() error { return multipartError("unsupported or invalid video field: " + name) }
+	switch name {
+	case "model", "prompt":
+		if strings.TrimSpace(value) == "" {
+			return invalid()
+		}
+		return nil
+	case "negative_prompt", "user", "control_type":
+		return nil
+	case "image_reference", "video_reference", "audio_reference":
+		_, err := multipartReferenceContents(llmprotocol.TaskVideoSync, name, value)
+		return err
+	case "quality":
+		if value == "high" || value == "lossless" {
+			return nil
+		}
+		return invalid()
+	case "size":
+		return llmprotocol.ValidateNativeImageGeneration(&llmprotocol.ImageGenerationOptions{Size: value, Native: &llmprotocol.NativeImageGenerationOptions{}})
+	case "aspect_ratio":
+		if value == "21:9" || value == "16:9" || value == "4:3" || value == "1:1" || value == "3:4" || value == "9:16" {
+			return nil
+		}
+		return invalid()
+	case "lora", "extra_params":
+		if validJSONObject(value) {
+			return nil
+		}
+		return invalid()
+	case "generate_sound", "enable_frame_interpolation", "return_stage_metrics":
+		if _, err := strconv.ParseBool(value); err != nil {
+			return invalid()
+		}
+		return nil
+	case "seed":
+		if _, err := strconv.ParseInt(value, 10, 64); err != nil {
+			return invalid()
+		}
+		return nil
+	case "width", "height", "num_frames", "seconds", "short_edge", "num_outputs_per_prompt", "num_inference_steps", "frame_interpolation_exp":
+		n, err := strconv.ParseInt(value, 10, 64)
+		if err != nil || n < 1 || (name == "num_outputs_per_prompt" && n > 10) || (name == "num_inference_steps" && n > 200) {
+			return invalid()
+		}
+		return nil
+	case "fps", "start_time_seconds", "guidance_scale", "guidance_scale_2", "boundary_ratio", "flow_shift", "true_cfg_scale", "sound_duration", "frame_interpolation_scale":
+		n, err := strconv.ParseFloat(value, 64)
+		if err != nil || math.IsNaN(n) || math.IsInf(n, 0) || n < 0 || (name == "fps" && n < 1) || ((name == "sound_duration" || name == "frame_interpolation_scale") && n <= 0) || (name == "boundary_ratio" && n > 1) {
+			return invalid()
+		}
+		return nil
+	}
+	return invalid()
+}
+
+// Project native reference fields into the ordinary ordered multimodal input.
+// No codec fetches URLs, reads client paths, or resolves provider-owned file IDs.
+func multipartReferenceContents(task llmprotocol.MultipartTask, name, value string) ([]llmprotocol.Content, error) {
+	kind := llmprotocol.ContentImage
+	var sources []string
+	if task == llmprotocol.TaskImageEdit {
+		switch name {
+		case "url", "url[]", "mask_image", "reference_image":
+			sources = []string{value}
+		default:
+			return nil, nil
+		}
+	} else if task == llmprotocol.TaskVideoSync || task == llmprotocol.TaskVideoCreate {
+		key := ""
+		switch name {
+		case "image_reference":
+			key = "image_url"
+		case "video_reference":
+			key = "video_url"
+			kind = llmprotocol.ContentVideo
+		case "audio_reference":
+			key = "audio_url"
+			kind = llmprotocol.ContentAudio
+		default:
+			return nil, nil
+		}
+		if err := validateNoDuplicateKeys([]byte(value), 16); err != nil {
+			return nil, err
+		}
+		var refs []map[string]string
+		raw := strings.TrimSpace(value)
+		if strings.HasPrefix(raw, "[") {
+			if err := json.Unmarshal([]byte(raw), &refs); err != nil {
+				return nil, multipartError("invalid reference array")
+			}
+		} else {
+			var ref map[string]string
+			if err := json.Unmarshal([]byte(raw), &ref); err != nil {
+				return nil, multipartError("invalid media reference")
+			}
+			refs = []map[string]string{ref}
+		}
+		if len(refs) < 1 || len(refs) > 16 {
+			return nil, multipartError("media reference count must be between 1 and 16")
+		}
+		for _, ref := range refs {
+			if len(ref) != 1 || ref[key] == "" {
+				return nil, multipartError("media reference requires its native URL; provider file IDs are not globally routable")
+			}
+			sources = append(sources, ref[key])
+		}
+	} else {
+		return nil, nil
+	}
+	result := make([]llmprotocol.Content, 0, len(sources))
+	for _, source := range sources {
+		content := llmprotocol.Content{Kind: kind, URL: source}
+		if media, data, ok := decodeDataURL(source); ok {
+			if !strings.HasPrefix(media, string(kind)+"/") {
+				return nil, multipartError("reference data URI has incompatible media type")
+			}
+			content.URL = ""
+			content.MediaType = media
+			content.Data = data
+		}
+		result = append(result, content)
+	}
+	return result, nil
+}
diff --git a/src/semantic-router/pkg/protocolcodec/multipart_video_test.go b/src/semantic-router/pkg/protocolcodec/multipart_video_test.go
new file mode 100644
index 000000000..3834b567a
--- /dev/null
+++ b/src/semantic-router/pkg/protocolcodec/multipart_video_test.go
@@ -0,0 +1,78 @@
+package protocolcodec
+
+import (
+	"bytes"
+	"github.com/vllm-project/semantic-router/src/semantic-router/pkg/llmprotocol"
+	"mime/multipart"
+	"strings"
+	"testing"
+)
+
+func videoForm(t *testing.T, fields [][2]string) ([]byte, string) {
+	t.Helper()
+	var body bytes.Buffer
+	w := multipart.NewWriter(&body)
+	for _, field := range fields {
+		if err := w.WriteField(field[0], field[1]); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return body.Bytes(), w.FormDataContentType()
+}
+func TestNativeVideoSyncReferencesAndGenerationSemantics(t *testing.T) {
+	fields := [][2]string{{"model", "auto"}, {"prompt", "a calm ocean"}, {"seconds", "4"}, {"size", "1280x720"}, {"seed", "17"}, {"generate_sound", "true"}, {"image_reference", `[{"image_url":"https://example.com/first.png"},{"image_url":"https://example.com/last.png"}]`}, {"audio_reference", `{"audio_url":"https://example.com/sound.wav"}`}, {"video_reference", `{"video_url":"https://example.com/clip.mp4"}`}}
+	body, ct := videoForm(t, fields)
+	engine := NewBuiltinEngine()
+	request, envelope, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OmniVideoSyncV1, body, ct)
+	if err != nil {
+		t.Fatal(err)
+	}
+	needed := llmprotocol.RequiredCapabilities(request)
+	for _, capability := range []llmprotocol.Capability{llmprotocol.CapabilityVideoGeneration, llmprotocol.CapabilityVideoOutput, llmprotocol.CapabilityAudioOutput, llmprotocol.CapabilityAudioInput, llmprotocol.CapabilityImageInput, llmprotocol.CapabilityVideoInput} {
+		if !needed.Supports(capability) {
+			t.Fatal("missing task capability", capability)
+		}
+	}
+	request.Model = "chosen"
+	request.Generation++
+	encoded, err := engine.EncodeRequest(llmprotocol.OmniVideoSyncV1, request, envelope)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(encoded.Body, []byte("chosen")) || !bytes.Contains(encoded.Body, []byte(fields[6][1])) {
+		t.Fatal("model or references lost")
+	}
+	if _, err := engine.EncodeRequest(llmprotocol.OpenAIChatV1, request, envelope); err == nil {
+		t.Fatal("video generation converted to Chat")
+	}
+	request.Messages[0].Content[1].URL = "https://example.com/changed.png"
+	if _, err := engine.EncodeRequest(llmprotocol.OmniVideoSyncV1, request, envelope); err == nil {
+		t.Fatal("native reference diverged from semantic capability input")
+	}
+}
+func TestNativeVideoSyncRejectsInvalidFieldsAndAcceptsPromptOnly(t *testing.T) {
+	engine := NewBuiltinEngine()
+	base := [][2]string{{"model", "auto"}, {"prompt", "a calm ocean"}}
+	for _, field := range [][2]string{{"stream", "true"}, {"seconds", "0"}, {"unknown", "x"}, {"fps", "NaN"}, {"num_outputs_per_prompt", "11"}, {"image_reference", `{"file_id":"provider-local"}`}, {"image_reference", `{"image_url":"https://example.com/a","image_url":"https://example.com/b"}`}, {"audio_reference", `{"audio_url":"file:///tmp/audio.wav"}`}} {
+		body, ct := videoForm(t, append(append([][2]string{}, base...), field))
+		if _, _, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OmniVideoSyncV1, body, ct); err == nil {
+			t.Fatal("invalid field accepted", field[0])
+		}
+	}
+	body, ct := videoForm(t, base)
+	req, _, _, err := engine.DecodeHTTPRequestForMutation(llmprotocol.OmniVideoSyncV1, body, ct)
+	if err != nil || req.Sampling.MaxOutputTokens != nil || len(req.Messages[0].Content) != 1 {
+		t.Fatal("prompt-only generation failed", err)
+	}
+	body, ct = videoForm(t, append(base, [2]string{"image_reference", `{"image_url":"data:image/png;base64,YQ=="}`}))
+	req, _, _, err = engine.DecodeHTTPRequestForMutation(llmprotocol.OmniVideoSyncV1, body, ct)
+	if err != nil || req.Messages[0].Content[1].Data != "YQ==" {
+		t.Fatal("inline reference lost", err)
+	}
+	if !strings.HasPrefix(ct, "multipart/form-data;") {
+		t.Fatal(ct)
+	}
+}
